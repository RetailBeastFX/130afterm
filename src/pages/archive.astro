---
import Layout from '../layouts/Layout.astro';
import SiteGlow from '../components/SiteGlow.astro';
import Navbar from '../components/Navbar.astro';
import ActivityTimeline from '../components/ActivityTimeline.astro';
import AskRb from '../components/AskRb.astro';
import Footer from '../components/Footer.astro';
import { sortedActivity } from '../data/activity';

// ARCHIVE — the memory of the room. Historical, append-only.
// Reads ActivityEvent data; merges live /api/activity entries client-side.
const events = sortedActivity();
---

<Layout title="130 AM // ARCHIVE" description="The archive — charts, builds, notes, and milestones from the 130 AM room." active="archive">
  <SiteGlow />
  <Navbar active="archive" />
  <AskRb />

  <main class="wrap pt-10 pb-4">
    <div class="stack">
      <header class="reveal">
        <span class="label">// the memory</span>
        <h1 class="display display-lg mt-2">archive</h1>
        <p class="note mt-2">everything worth remembering 📼</p>
        <p class="body-dim text-sm mt-4 max-w-md">
          charts, notes, wins, losses, lessons. append-only — what's written here stays.
        </p>
      </header>

      <div class="reveal">
        <ActivityTimeline events={events} limit={100} />
      </div>
    </div>
  </main>

  <Footer />
</Layout>
