---
import Layout from '../layouts/Layout.astro';
import SiteGlow from '../components/SiteGlow.astro';
import Navbar from '../components/Navbar.astro';
import RightNow from '../components/RightNow.astro';
import Pinboard from '../components/Pinboard.astro';
import AskRb from '../components/AskRb.astro';
import Footer from '../components/Footer.astro';
import { latestActivity } from '../data/activity';

// NOW — the heartbeat page. "What is Bo doing right now?"
// Consumes NowState (live presence + persisted fields). ActivityEvents
// stay a separate, read-only bridge below.
const recentEvents = latestActivity(5);
---

<Layout
  title="130 AM // NOW"
  description="What is Bo doing right now? Live status from 130AfterM — trading, building, gaming, living."
  active="now"
>
  <SiteGlow />
  <Navbar active="now" />
  <AskRb />

  <main class="wrap pt-10 pb-4">
    <div class="stack">
      <header class="reveal">
        <span class="label">// the heartbeat</span>
        <h1 class="display display-lg mt-2">now</h1>
        <p class="note mt-2">what's happening in the room, live-ish 🌙</p>
      </header>

      <RightNow showLink={false} />

      <div class="card card-flat reveal" style="background: rgba(255,176,0,0.04); border: 1px dashed rgba(255,176,0,0.25);">
        <p class="text-sm body-dim">
          this page answers one question: <strong style="color: var(--ink);">what is bo doing right now?</strong>
          the card above blends live presence with a state bo commits himself from the terminal.
          nothing here is auto-logged — the archive only gets what he chooses to remember.
        </p>
      </div>

      <Pinboard events={recentEvents} />
    </div>
  </main>

  <Footer />
</Layout>
