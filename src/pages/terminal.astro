---
import Layout from '../layouts/Layout.astro';
import AmbientBackground from '../components/AmbientBackground.astro';
import Navbar from '../components/Navbar.astro';
import EngineCanvas from '../components/EngineCanvas.tsx';
---

<Layout title="130 AM // TERMINAL">
  <div id="r3f-root" class="fixed inset-0 -z-10 w-screen h-screen">
    <EngineCanvas client:load />
  </div>
  
  <div id="main-container" style="perspective:1500px;transform-style:preserve-3d;transition:transform .1s ease-out;">
    <AmbientBackground />
    <Navbar />
    
<main id="swup" class="transition-fade  id="main-content" class="max-w-4xl mx-auto p-6 md:p-12 relative z-10"">
        
        <a href="./index.html" class="inline-flex items-center gap-2 text-[10px] tracking-widest text-zinc-500 hover:text-amber-500 mb-8 transition-colors font-mono glitch-hover">
            <i class="fas fa-arrow-left"></i> RETURN TO IDENTITY
        </a>

        <!-- ── HEADER ── -->
        <header class="glass-panel p-8 mb-10 flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
            <div>
                <h1 id="main-title" class="bg-gradient-to-r from-[#f59e0b] via-[#f97316] to-[#38bdf8] bg-clip-text text-transparent text-5xl md:text-6xl font-black tracking-tighter cursor-pointer glitch-hover uppercase">130AfterM // LABS</h1>
                <p class="font-mono text-xs tracking-widest mt-3 opacity-70">EXECUTION TERMINAL v0.8.4 • LIVE</p>
                <p class="text-sm mt-3 opacity-90 amber-text transition-colors duration-300 font-medium"
                    data-sys="Markets. Systems. Media. Built after hours."
                    data-norm="Documenting charts, systems, and the process behind both.">
                    Markets. Systems. Media. Built after hours.
                </p>
            </div>
            <button id="mode-toggle" class="glass-panel px-6 py-3 flex items-center gap-3 text-[11px] tracking-widest font-mono hover:bg-white/5 transition-colors group cursor-pointer border border-white/10">
                <span id="mode-sys" class="amber-text font-bold">SYS</span>
                <span class="opacity-40">/</span>
                <span id="mode-norm" class="opacity-50">NORM</span>
            </button>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- ── LEFT COLUMN ── -->
            <div class="space-y-6">
                <section>
                    <h2 class="text-xs font-mono uppercase amber-text mb-4 border-l-2 border-orange-600 pl-3 transition-colors duration-300 tracking-widest glitch-hover"
                        data-sys="RBFX_LABS // TOOLS" data-norm="Trading Tools">RBFX_LABS // TOOLS</h2>
                    <div class="glass-panel p-6">
                        <div class="flex justify-between items-start mb-3">
                            <h3 class="font-bold text-lg text-white">RetailBeastFX // Market Engine v7</h3>
                            <span class="text-[10px] font-mono border border-[#26a69a] bg-[#26a69a]/10 px-2 py-1 rounded-full text-[#26a69a] animate-pulse uppercase tracking-widest">LIVE</span>
                        </div>
                        <p class="text-sm opacity-80 leading-relaxed mt-3">
                            Automated spatial mapping of the 15m Opening Range. Features a real-time Thesis Integrity Engine, 9/21 EMA trend filtering, and a dynamic L5 Trade Management FSM. Built explicitly for high-momentum SPY 0DTE execution.
                        </p>
                        <div class="mt-6 pt-6 border-t border-white/5">
                            <a href="https://whop.com/joined/retailbeastfx/products/retailbeastfx-smc-indicator/" target="_blank" class="link-btn inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase">
                                <span>[ DEPLOY ENGINE v7 ]</span>
                                <i class="fas fa-external-link-alt text-[10px] opacity-70"></i>
                            </a>
                        </div>
                    </div>
                </section>

                <section>
                    <h2 class="text-xs font-mono uppercase amber-text mb-4 border-l-2 border-orange-600 pl-3 transition-colors duration-300 tracking-widest glitch-hover"
                        data-sys="Time_Investment" data-norm="Where My Time Goes">Time_Investment</h2>
                    <div class="glass-panel p-6">
                        <p class="text-sm mb-4 opacity-80 font-medium">Thousands of hours logged across multiple disciplines:</p>
                        <ul class="space-y-3 text-[11px] font-mono opacity-80 tracking-wide">
                            <li class="flex gap-3 items-start"><span class="amber-text">>></span> Tape Reading, Chart Study &amp; Market Execution</li>
                            <li class="flex gap-3 items-start"><span class="amber-text">>></span> Video Editing, Music Videos &amp; Visual Design</li>
                            <li class="flex gap-3 items-start"><span class="amber-text">>></span> System Building &amp; Custom PC Architecture</li>
                            <li class="flex gap-3 items-start"><span class="amber-text">>></span> Hardware Jailbreaking (Active since '08)</li>
                        </ul>
                    </div>
                </section>
            </div>

            <!-- ── RIGHT COLUMN ── -->
            <div class="space-y-6">
                <section>
                    <h2 class="text-xs font-mono uppercase amber-text mb-4 border-l-2 border-orange-600 pl-3 transition-colors duration-300 tracking-widest glitch-hover"
                        data-sys="External_Signals" data-norm="Outside the Screen">External_Signals</h2>
                    <div class="glass-panel p-6">
                        <span class="text-[10px] opacity-60 font-mono mb-4 block tracking-widest uppercase border border-white/10 w-max px-2 py-1 rounded"
                            data-sys="NON-CORE INPUTS DETECTED"
                            data-norm="What I'm into when I'm not building:">NON-CORE INPUTS DETECTED</span>
                        <ul class="space-y-3 text-[11px] font-mono opacity-80 tracking-wide">
                            <li class="flex gap-3 items-start"><span class="amber-text">>></span> Late night thinking &gt; early mornings</li>
                            <li class="flex gap-3 items-start"><span class="amber-text">>></span> Music + visuals (anything with mood)</li>
                            <li class="flex gap-3 items-start"><span class="amber-text">>></span> Breaking tech just to see how it works</li>
                            <li class="flex gap-3 items-start"><span class="amber-text">>></span> Time with my kids &#8212; non-negotiable</li>
                        </ul>
                    </div>
                </section>

                <section>
                    <h2 class="text-xs font-mono uppercase amber-text mb-4 border-l-2 border-orange-600 pl-3 transition-colors duration-300 tracking-widest glitch-hover"
                        data-sys="Recent_Artifacts" data-norm="Recent Work">Recent_Artifacts</h2>
                    
                    <div class="artifacts-sys space-y-4">
                        <div class="glass-panel p-5 flex flex-col sm:flex-row items-center sm:items-start gap-5 group">
                            <div class="w-full sm:w-32 h-20 bg-black rounded-lg border border-white/10 overflow-hidden flex items-center justify-center opacity-80 group-hover:opacity-100 transition-opacity flex-shrink-0 relative">
                                <span class="font-mono text-[10px] tracking-widest text-zinc-600">CHART_IMG</span>
                                <div class="absolute inset-0 bg-amber-500/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-2">
                                    <span class="font-mono text-[9px] border border-[#f59e0b]/30 bg-[#f59e0b]/10 px-2 py-1 rounded text-[#f59e0b] uppercase tracking-widest">TRADE</span>
                                    <p class="text-sm font-bold amber-text">Execution Log &#8212; SPY ORB Breakout</p>
                                </div>
                                <p class="text-xs opacity-70 leading-relaxed mb-3">Clean entry on the 5m candle close outside the 15m ORH. EMAs stacked. Trailed the 8 EMA for a full 2R run. Documented the FSM state changes.</p>
                                <a href="https://x.com/RetailBeastFX" target="_blank"
                                    class="text-[10px] opacity-60 hover:opacity-100 hover:text-[var(--terminal-amber)] transition-all inline-block font-mono font-bold tracking-widest uppercase">&#8594; VIEW ON X</a>
                            </div>
                        </div>

                        <div class="glass-panel p-5 flex flex-col sm:flex-row items-center sm:items-start gap-5 group">
                            <div class="w-full sm:w-32 h-20 bg-black rounded-lg border border-white/10 overflow-hidden flex items-center justify-center opacity-80 group-hover:opacity-100 transition-opacity flex-shrink-0 relative">
                                <span class="font-mono text-[10px] tracking-widest text-zinc-600">VIDEO_IMG</span>
                                <div class="absolute inset-0 bg-amber-500/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-2">
                                    <span class="font-mono text-[9px] border border-[#38bdf8]/30 bg-[#38bdf8]/10 px-2 py-1 rounded text-[#38bdf8] uppercase tracking-widest">EDIT</span>
                                    <p class="text-sm font-bold amber-text">VHS Log &#8212; Process Capture</p>
                                </div>
                                <p class="text-xs opacity-70 leading-relaxed mb-3">Grading system used to document late-night builds and real-time thinking.</p>
                                <a href="https://www.youtube.com/@130AfterM" target="_blank"
                                    class="text-[10px] opacity-60 hover:opacity-100 hover:text-[var(--terminal-amber)] transition-all inline-block font-mono font-bold tracking-widest uppercase">&#8594; VIEW ON YT</a>
                            </div>
                        </div>

                        <div class="glass-panel p-5 flex flex-col sm:flex-row items-center sm:items-start gap-5 group">
                            <div class="w-full sm:w-32 h-20 bg-black rounded-lg border border-white/10 overflow-hidden flex items-center justify-center opacity-80 group-hover:opacity-100 transition-opacity flex-shrink-0 relative">
                                <span class="font-mono text-[10px] tracking-widest text-zinc-600">CODE_IMG</span>
                                <div class="absolute inset-0 bg-amber-500/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-2">
                                    <span class="font-mono text-[9px] border border-[#26a69a]/30 bg-[#26a69a]/10 px-2 py-1 rounded text-[#26a69a] uppercase tracking-widest">BUILD</span>
                                    <p class="text-sm font-bold amber-text">Risk Calculator v1.4</p>
                                </div>
                                <p class="text-xs opacity-70 leading-relaxed mb-3">Updated for multi-pair tracking. Includes session exposure cap.</p>
                                <a href="https://github.com/RetailBeastFX/" target="_blank"
                                    class="text-[10px] opacity-60 hover:opacity-100 hover:text-[var(--terminal-amber)] transition-all inline-block font-mono font-bold tracking-widest uppercase">&#8594; VIEW ON GH</a>
                            </div>
                        </div>
                    </div>

                    <div class="artifacts-norm space-y-4">
                        <div class="glass-panel p-5 flex flex-col sm:flex-row items-center sm:items-start gap-5 group">
                            <div class="w-full sm:w-32 h-20 bg-black rounded-lg border border-blue-500/20 overflow-hidden flex items-center justify-center opacity-80 group-hover:opacity-100 transition-opacity flex-shrink-0 relative">
                                <span class="font-mono text-[10px] tracking-widest text-blue-900">CHART_IMG</span>
                                <div class="absolute inset-0 bg-blue-500/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-2">
                                    <span class="font-mono text-[9px] border border-blue-500/30 bg-blue-500/10 px-2 py-1 rounded text-blue-400 uppercase tracking-widest">TRADE</span>
                                    <p class="text-sm font-bold text-blue-400">Live Trade &#8212; Clean 1:3 Setup</p>
                                </div>
                                <p class="text-xs opacity-70 leading-relaxed mb-3">Caught a textbook rejection at a daily high. Documented the whole thing in real time.</p>
                                <a href="https://x.com/RetailBeastFX" target="_blank"
                                    class="text-[10px] opacity-60 hover:opacity-100 hover:text-blue-400 transition-all inline-block font-mono font-bold tracking-widest uppercase">&#8594; See it on X</a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <footer class="mt-16 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-6">
            <div class="text-center md:text-left">
                <p class="text-[11px] uppercase tracking-[0.2em] opacity-80 font-bold">Built After Hours</p>
                <p class="text-[9px] mt-2 opacity-50 font-mono tracking-widest">01:30AM LOG</p>
            </div>
            <div class="text-[9px] opacity-50 font-mono tracking-widest text-center md:text-right leading-relaxed uppercase">
                BUILD_VER: 3.3.0<br>
                <span class="amber-text font-bold opacity-100">AFTER HOURS // GLASS</span>
            </div>
        </footer>
    </main>
  </div>

  <script>
    const isMobile = () => window.matchMedia('(max-width: 768px)').matches || ('ontouchstart' in window);
    const container = document.getElementById('main-container');

    if (!isMobile()) {
      document.addEventListener('mousemove', (e) => {
        if (!container) return;
        const x = (e.clientX / window.innerWidth) - 0.5;
        const y = (e.clientY / window.innerHeight) - 0.5;
        container.style.transform = `rotateY(${x * 4}deg) rotateX(${-y * 4}deg)`;
      });
    }

    // Scroll reveal
    document.addEventListener('DOMContentLoaded', () => {
      const obs=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add("visible");obs.unobserve(e.target);}}),{threshold:.1});
      document.querySelectorAll(".reveal").forEach(el=>obs.observe(el));
    });
  </script>
</Layout>
