---
import Layout from '../layouts/Layout.astro';
import SiteGlow from '../components/SiteGlow.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AskRb from '../components/AskRb.astro';
import { baseNowState } from '../data/now';
import { latestActivity } from '../data/activity';

/**
 * Terminal — the control room behind the hangout spot.
 *
 * READ:  ActivityEvent (historical memory) — activity.ts
 * READ:  NowState (current state)          — now.ts + /api/now
 * WRITE: NowState editable fields only    — via /api/now (NOW_API_TOKEN)
 *
 * [ COMMIT SNAPSHOT ] updates /now.
 * [ LOG THIS ] writes the snapshot to the archive via /api/activity.
 */

const now = baseNowState;
const recentActivity = latestActivity(5);
---

<Layout title="130 AM // TERMINAL" description="The control room — update the room's state, log moments to the archive." active="terminal">
  <SiteGlow />
  <Navbar active="terminal" />
  <AskRb />

  <main class="wrap pt-10 pb-4">
    <div class="stack">
      <header class="reveal">
        <span class="label">// the control room</span>
        <h1 class="display display-lg mt-2">terminal</h1>
        <p class="note mt-2">staff only. you're staff, right? 🎛</p>
      </header>

      <!-- ── SYSTEM STATUS ── -->
      <section class="reveal" aria-label="System status">
        <div class="grid gap-4 sm:grid-cols-2">
          <!-- NOW STATE — reads /api/now, patched client-side -->
          <div class="card">
            <div class="flex items-center justify-between mb-3">
              <span class="label">now state</span>
              <span class="flex items-center gap-2">
                <span id="term-status-dot" class="status-dot" aria-hidden="true"></span>
                <span id="term-status-label" class="mono" style="font-size: 9px; letter-spacing: 0.2em; color: var(--ink-faint);">—</span>
              </span>
            </div>
            <div>
              {[
                { key: 'building', label: 'BUILDING' },
                { key: 'trading', label: 'TRADING' },
                { key: 'working_on', label: 'WORKING ON' },
                { key: 'mood', label: 'MOOD' },
                { key: 'location', label: 'LOCATION' },
              ].map((row) => (
                <div class="now-row" data-now-key={row.key}>
                  <span class="now-key">{row.label}</span>
                  <span class="now-val" data-val>{(now as any)[row.key] ?? '—'}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- RECENT ACTIVITY — read-only bridge -->
          <div class="card">
            <span class="label block mb-3">recent activity</span>
            <div class="flex flex-col gap-2.5">
              {recentActivity.map((ev) => (
                <a href="/archive" class="flex items-baseline gap-3 min-h-[44px]">
                  <span class="mono" style="font-size: 10px; color: var(--ink-faint); flex-shrink: 0;">{ev.date.slice(5)}</span>
                  <span class="text-sm font-medium truncate" style="color: var(--ink-dim);">{ev.title}</span>
                </a>
              ))}
            </div>
            <a href="/archive" class="mono inline-flex items-center mt-3" style="font-size: 10px; letter-spacing: 0.2em; color: var(--amber); min-height: 44px;">FULL ARCHIVE →</a>
          </div>
        </div>
      </section>

      <!-- ── DAILY SNAPSHOT ── -->
      <section class="card tape reveal" aria-label="Daily snapshot">
        <span class="label block mb-1">// daily_snapshot</span>
        <p class="text-sm body-faint mb-5">commit the current state of the room.</p>

        <div class="flex flex-col gap-1">
          {[
            { key: 'building', label: 'BUILDING' },
            { key: 'trading', label: 'TRADING' },
            { key: 'working_on', label: 'FOCUS' },
            { key: 'mood', label: 'MOOD' },
            { key: 'location', label: 'LOCATION' },
          ].map((row) => (
            <div class="flex items-center gap-3">
              <label class="mono" style="font-size: 10px; letter-spacing: 0.18em; color: var(--ink-faint); width: 88px; flex-shrink: 0;" for={`snap-${row.key}`}>{row.label}</label>
              <input
                type="text"
                id={`snap-${row.key}`}
                data-snapshot-field={row.key}
                class="input flex-1"
                style="min-height: 48px;"
                placeholder={`enter ${row.key}…`}
                maxlength="120"
              />
            </div>
          ))}
        </div>

        <p id="term-set-output" class="mono mt-4 min-h-[1.4rem]" style="font-size: 11px; color: var(--ink-faint);" role="status"></p>

        <div class="flex flex-col sm:flex-row gap-3 mt-2">
          <button id="term-commit-btn" class="btn btn-amber flex-1">[ commit snapshot ]</button>
          <button id="term-log-btn" class="btn btn-ghost flex-1">[ log this ]</button>
        </div>

        <p class="mono mt-4" style="font-size: 9px; letter-spacing: 0.12em; color: var(--ink-faint);">
          COMMIT updates /now · LOG THIS writes to /archive · requires NOW_API_TOKEN
        </p>
      </section>

      <!-- ── TOOLS ── -->
      <section class="reveal" aria-label="Tools">
        <h2 class="display display-md mb-4">the toolbox</h2>
        <div class="card">
          <div class="flex items-center justify-between mb-2 flex-wrap gap-2">
            <h3 class="font-bold">RetailBeastFX — Market Engine</h3>
            <span class="sticker sticker-mint">live</span>
          </div>
          <p class="text-sm body-dim mb-5">
            Automated spatial mapping of the 15m opening range. Thesis integrity engine,
            9/21 EMA trend filtering, dynamic trade management. Built for high-momentum SPY 0DTE execution.
          </p>
          <a
            href="https://whop.com/joined/retailbeastfx/products/retailbeastfx-smc-indicator/"
            target="_blank"
            rel="noopener"
            class="btn btn-ghost w-full"
          >
            open the engine →
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer />

  <script>
    // ── TERMINAL write logic (unchanged contract) ─────────────────────────
    // COMMIT → POST /api/now        (updates the NowState, /now page)
    // LOG    → POST /api/activity   (appends an ActivityEvent to /archive)
    // Both require the NOW_API_TOKEN Bearer token.

    const EDITABLE = new Set(['building', 'trading', 'working_on', 'mood', 'location']);
    const commitBtn = document.getElementById('term-commit-btn');
    const logBtn = document.getElementById('term-log-btn');
    const setOutput = document.getElementById('term-set-output');

    function setTermOutput(msg, color) {
      if (!setOutput) return;
      setOutput.textContent = msg;
      setOutput.style.color = color || 'var(--ink-faint)';
    }

    function getToken() {
      let token = sessionStorage.getItem('now_token');
      if (!token) {
        token = prompt('NOW_API_TOKEN:');
        if (!token) return null;
        sessionStorage.setItem('now_token', token);
      }
      return token;
    }

    function collectPayload() {
      const payload = {};
      let ok = true;
      document.querySelectorAll('input[data-snapshot-field]').forEach((input) => {
        const key = input.getAttribute('data-snapshot-field');
        const val = input.value.trim();
        if (!EDITABLE.has(key)) return;
        if (!val) return; // skip empty — partial snapshots allowed
        if (val.length > 120) {
          setTermOutput('Value for ' + key + ' too long (max 120 chars).', '#f87171');
          ok = false;
        } else {
          payload[key] = val;
        }
      });
      return ok ? payload : null;
    }

    async function postJSON(url, payload, token) {
      return fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: 'Bearer ' + token,
        },
        body: JSON.stringify(payload),
      });
    }

    async function executeSnapshot() {
      const payload = collectPayload();
      if (!payload) return;
      if (Object.keys(payload).length === 0) {
        setTermOutput('Nothing to commit — fill in at least one field.');
        return;
      }
      const token = getToken();
      if (!token) { setTermOutput('Cancelled.'); return; }

      setTermOutput('Committing snapshot…');
      if (commitBtn) commitBtn.disabled = true;
      if (logBtn) logBtn.disabled = true;

      try {
        const res = await postJSON('/api/now', payload, token);
        if (res.status === 401) {
          sessionStorage.removeItem('now_token');
          setTermOutput('Unauthorized. Token cleared — try again.', '#f87171');
          return;
        }
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          setTermOutput(err.error || ('Error ' + res.status), '#f87171');
          return;
        }
        setTermOutput('✓ Snapshot committed. /now is updated.', '#6ee7b7');
        // Patch the read panel immediately
        for (const [field, value] of Object.entries(payload)) {
          const row = document.querySelector('[data-now-key="' + field + '"] [data-val]');
          if (row) row.textContent = value;
        }
      } catch (e) {
        setTermOutput(e.message, '#f87171');
      } finally {
        if (commitBtn) commitBtn.disabled = false;
        if (logBtn) logBtn.disabled = false;
      }
    }

    async function executeLogThis() {
      const payload = collectPayload();
      if (!payload) return;
      if (Object.keys(payload).length === 0) {
        setTermOutput('Nothing to log — fill in at least one field.');
        return;
      }
      const token = getToken();
      if (!token) { setTermOutput('Cancelled.'); return; }

      setTermOutput('Logging to archive…');
      if (commitBtn) commitBtn.disabled = true;
      if (logBtn) logBtn.disabled = true;

      try {
        const res = await postJSON('/api/activity', payload, token);
        if (res.status === 401) {
          sessionStorage.removeItem('now_token');
          setTermOutput('Unauthorized. Token cleared — try again.', '#f87171');
          return;
        }
        if (!res.ok) {
          setTermOutput('Error ' + res.status, '#f87171');
          return;
        }
        const dateStr = new Date().toISOString().slice(0, 16).replace('T', ' ');
        setTermOutput('[EVENT COMMITTED] ' + dateStr + ' — snapshot → archive', '#6ee7b7');
      } catch (e) {
        setTermOutput(e.message, '#f87171');
      } finally {
        if (commitBtn) commitBtn.disabled = false;
        if (logBtn) logBtn.disabled = false;
      }
    }

    if (commitBtn) commitBtn.addEventListener('click', executeSnapshot);
    if (logBtn) logBtn.addEventListener('click', executeLogThis);
    document.querySelectorAll('input[data-snapshot-field]').forEach((input) => {
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') executeSnapshot();
      });
    });

    // ── Status: patch NowState read panel from /api/now ───────────────────
    (async function loadTerminalNow() {
      try {
        const res = await fetch('/api/now');
        if (!res.ok) return;
        const stored = await res.json();
        document.querySelectorAll('[data-now-key]').forEach((row) => {
          const key = row.getAttribute('data-now-key');
          const valEl = row.querySelector('[data-val]');
          if (valEl && stored[key]) valEl.textContent = stored[key];
        });
        document.querySelectorAll('input[data-snapshot-field]').forEach((input) => {
          const key = input.getAttribute('data-snapshot-field');
          if (stored[key]) input.value = stored[key];
        });
      } catch (e) { /* static baseline stays */ }
    })();

    // ── Discord presence dot (Lanyard, read-only) ─────────────────────────
    (async function loadTerminalPresence() {
      const STATUS = {
        online: { cls: 'online', label: 'ONLINE' },
        idle: { cls: 'idle', label: 'IDLE' },
        dnd: { cls: 'dnd', label: 'DO NOT DISTURB' },
        offline: { cls: '', label: 'OFFLINE' },
      };
      try {
        const res = await fetch('https://api.lanyard.rest/v1/users/385513048237932564');
        if (!res.ok) return;
        const { data } = await res.json();
        const cfg = STATUS[data.discord_status] || STATUS.offline;
        const dot = document.getElementById('term-status-dot');
        const label = document.getElementById('term-status-label');
        if (dot) dot.className = 'status-dot ' + cfg.cls;
        if (label) { label.textContent = cfg.label; }
      } catch (e) { /* static stays */ }
    })();
  </script>
</Layout>
