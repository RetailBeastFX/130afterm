---
import Layout from '../layouts/Layout.astro';
import SiteGlow from '../components/SiteGlow.astro';
import Navbar from '../components/Navbar.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import RightNow from '../components/RightNow.astro';
import RbCorner from '../components/RbCorner.astro';
import LatestRants from '../components/LatestRants.astro';
import QuoteWall from '../components/QuoteWall.astro';
import Pinboard from '../components/Pinboard.astro';
import CurrentlyShelf from '../components/CurrentlyShelf.astro';
import Guestbook from '../components/Guestbook.astro';
import LinkGarden from '../components/LinkGarden.astro';
import AskRb from '../components/AskRb.astro';
import Footer from '../components/Footer.astro';
import { latestActivity } from '../data/activity';
import { getCollection } from 'astro:content';
import { sortNewest } from '../lib/blog';

const recentEvents = latestActivity(6);
const rantPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(sortNewest);
---

<Layout title="130 AM // after hours." active="home">
  <SiteGlow />
  <Navbar active="home" />
  <AskRb />

  <main class="wrap pt-10 pb-4">
    <div class="stack">
      <ProfileHeader />
      <RightNow />
      <RbCorner />
      <LatestRants posts={rantPosts} />
      <Pinboard events={recentEvents} />
      <CurrentlyShelf />
      <QuoteWall />
      <Guestbook />
      <LinkGarden compact />
    </div>
  </main>

  <Footer />
</Layout>
