---
import Layout from '../layouts/Layout.astro';
import SiteGlow from '../components/SiteGlow.astro';
import Navbar from '../components/Navbar.astro';
import Loader from '../components/Loader.astro';
import Hero from '../components/Hero.astro';
import RailChart from '../components/RailChart.astro';
import Marquee from '../components/Marquee.astro';
import OrbCard from '../components/OrbCard.astro';
import Widgets from '../components/Widgets.astro';
import MediaLibrary from '../components/MediaLibrary.astro';
import Sponsored from '../components/Sponsored.astro';
import FooterSurprise from '../components/FooterSurprise.astro';
import RightNow from '../components/RightNow.astro';
import RbCorner from '../components/RbCorner.astro';
import LatestRants from '../components/LatestRants.astro';
import QuoteWall from '../components/QuoteWall.astro';
import Top8 from '../components/Top8.astro';
import Pinboard from '../components/Pinboard.astro';
import CurrentlyShelf from '../components/CurrentlyShelf.astro';
import Guestbook from '../components/Guestbook.astro';
import LinkGarden from '../components/LinkGarden.astro';
import AskRb from '../components/AskRb.astro';
import Ticker from '../components/Ticker.astro';
import TerminalBackground from '../components/TerminalBackground.astro';
import LatestTeaser from '../components/LatestTeaser.astro';
import JourneyEntry from '../components/JourneyEntry.astro';
import ToolsShelf from '../components/ToolsShelf.astro';
import LoopBand from '../components/LoopBand.astro';
import SignoffFooter from '../components/SignoffFooter.astro';
import LossCut from '../components/LossCut.astro';
import HomeScripts from '../components/HomeScripts.astro';
import { latestActivity } from '../data/activity';
import { getCollection } from 'astro:content';
import { sortNewest } from '../lib/blog';

const recentEvents = latestActivity(6);
const rantPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(sortNewest);
const tickerLines = rantPosts
  .map((p) => p.data.highlight)
  .filter((h): h is string => !!h);

const labNotes = (await getCollection('lab')).sort((a, b) => a.data.number - b.data.number);
const featuredNotes = labNotes.filter((n) =>
  ['15-minute-orb', '1130-chop-rule', 'give-back'].includes(n.id.replace(/\.md$/, ''))
);

function pad(n: number): string {
  return String(n).padStart(3, '0');
}

function fmt(d: Date): string {
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

const statusClass: Record<string, string> = {
  observation: 'sticker-sky',
  hypothesis: 'sticker-amber',
  testing: 'sticker-rose',
  validated: 'sticker-mint',
};

const statusLabel: Record<string, string> = {
  observation: 'OBSERVATION',
  hypothesis: 'HYPOTHESIS',
  testing: 'IN TESTING',
  validated: 'VALIDATED IN TESTING',
};
---

<Layout title="RetailBo — the market and the man." active="home">
  <div class="blue-site">
    <div class="b-frame">
      <SiteGlow />
      <Loader />
      <Navbar active="home" />
      <AskRb />

      <div class="b-grid">
        <TerminalBackground />
        <div class="b-main">
          <div class="rb-contentsWrapper">
            <Hero />
    <LatestTeaser />
    <Widgets />
    <Marquee />

    <!-- ═══ THE MARKET — side head ═══ -->
    <div class="band b-side-head" id="b-market">
      <div class="b-wrap">
        <hgroup class="rb-content_title">
          <p class="b-side-num">Side 01 / 03</p>
          <h2 class="b-side-title">The <span>Market</span></h2>
          <p class="b-side-desc">Trading, market thoughts, strategies, lessons. The journey entry, the lab notes, and the tools — all in one place.</p>
          <p class="rb-content_title--txt"><span>RetailBo</span></p>
        </hgroup>
      </div>
    </div>

    <JourneyEntry />
    <Marquee />

    <!-- ═══ THE LAB ═══ -->
    <section class="band rb-content rb-content--lab" data-section="lab" id="b-lab">
      <div class="lab_grad rb-grad" aria-hidden="true"></div>
      <div class="rb-contPtnBg_wrapper" aria-hidden="true"><div class="rb-contPtnBg"></div></div>
      <div class="lab__decoWrapper rb-decoWrapper" aria-hidden="true">
        <span class="b-deco b-deco-yen b-deco-a">¥</span>
        <span class="b-deco b-deco-yen b-deco-b">¥</span>
      </div>
      <div class="b-wrap rb-content-container lab-container">
        <div>
          <hgroup class="rb-content_title">
            <p class="b-kicker">
              <span class="b-chip">Lab</span>
              <span class="b-date">Research note</span>
              <span class="b-cat trading">Trading</span>
            </p>
            <h2 class="b-h">The Lab</h2>
            <p class="rb-content_title--txt"><span>RetailBo</span></p>
          </hgroup>
          <div class="b-oswin light off-b">
            <div class="b-win-bar">
              <span class="wdot a"></span><span class="wdot b"></span><span class="wdot c"></span>
              <span class="b-win-title">LAB — RESEARCH NOTE</span>
              <span class="b-win-ctl" aria-hidden="true"><i>–</i><i>□</i><i>×</i></span>
            </div>
            <div class="b-oswin-body">
              <div class="stack">
                {featuredNotes.map((note) => (
                  <a href={`/lab/${note.id.replace(/\.md$/, '')}/`} class="card block reveal lab-card">
                    <div class="flex items-center gap-3 mb-2 flex-wrap">
                      <span
                        class="mono"
                        style="font-size: 11px; color: var(--card-ink-faint); letter-spacing: 0.14em;"
                      >
                        {pad(note.data.number)}
                      </span>
                      <span class:list={['sticker', statusClass[note.data.status]]}>
                        {statusLabel[note.data.status]}
                      </span>
                      {note.data.instruments.map((i) => (
                        <span class="mono" style="font-size: 10px; color: var(--card-ink-faint);">{i}</span>
                      ))}
                    </div>
                    <h3 class="display text-xl mb-1">{note.data.title}</h3>
                    <p class="body-dim text-sm">{note.data.description}</p>
                    <div
                      class="mono mt-3"
                      style="font-size: 10px; letter-spacing: 0.14em; color: var(--card-ink-faint);"
                    >
                      UPDATED {fmt(note.data.updated ?? note.data.date)} · READ →
                    </div>
                  </a>
                ))}
                <p>
                  <a href="/lab" class="btn btn-ghost">open the trading lab →</a>
                  <a href="/journal" class="btn btn-ghost" style="margin-left: 8px;">the journal →</a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ INDICATOR ═══ -->
    <section class="band rb-content rb-content--indicator" data-section="indicator" id="b-indicator">
      <div class="indicator_grad rb-grad" aria-hidden="true"></div>
      <div class="rb-contPtnBg_wrapper" aria-hidden="true"><div class="rb-contPtnBg"></div></div>
      <div class="indicator__decoWrapper rb-decoWrapper" aria-hidden="true">
        <span class="b-deco b-deco-eur b-deco-a">€</span>
        <span class="b-deco b-deco-eur b-deco-b">€</span>
      </div>
      <div class="b-wrap rb-content-container indicator-container">
        <div>
          <hgroup class="rb-content_title">
            <p class="b-kicker">
              <span class="b-chip">Indicator</span>
              <span class="b-date">TradingView</span>
              <span class="b-cat money">Money</span>
            </p>
            <h2 class="b-h">Indicator</h2>
            <p class="rb-content_title--txt"><span>RetailBo</span></p>
          </hgroup>
          <OrbCard />
        </div>
      </div>
    </section>

    <!-- ═══ THE MAN ═══ -->
    <section class="band rb-content rb-content--man b-side-head" data-section="man" id="b-man">
      <div class="man_grad rb-grad" aria-hidden="true"></div>
      <div class="rb-contPtnBg_wrapper" aria-hidden="true"><div class="rb-contPtnBg"></div></div>
      <div class="man__decoWrapper rb-decoWrapper" aria-hidden="true">
        <span class="b-deco b-deco-star b-deco-a">★</span>
        <span class="b-deco b-deco-star b-deco-b">★</span>
      </div>
      <div class="b-wrap rb-content-container man-container">
        <div>
          <hgroup class="rb-content_title">
            <p class="b-side-num">Side 02 / 03</p>
            <h2 class="b-side-title">The <span>Man</span></h2>
            <p class="b-side-desc">Personal thoughts, life, mindset, experiences — the side of the site outside the market.</p>
            <p class="rb-content_title--txt"><span>RetailBo</span></p>
          </hgroup>
          <div class="stack">
            <LatestRants posts={rantPosts} />
            <RightNow />
            <RbCorner />
            <CurrentlyShelf />
            <QuoteWall />
            <Top8 />
            <Guestbook />
            <LinkGarden compact />
            <Pinboard events={recentEvents} />
            <figure class="b-man-art b-reveal">
              <img
                src="/assets/moon-base.webp"
                alt="Moon World: a green-lit lunar base with a satellite dish and a landed ship under a huge full moon, Earth hanging in the starry sky."
                width="1170"
                height="658"
                loading="lazy"
              />
              <figcaption>MOON WORLD · THE QUIET SIDE OF THE SAME PLACE</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ THE MEDIA ═══ -->
    <section class="band rb-content rb-content--media b-side-head" data-section="media" id="b-media">
      <div class="media_grad rb-grad" aria-hidden="true"></div>
      <div class="rb-contPtnBg_wrapper" aria-hidden="true"><div class="rb-contPtnBg"></div></div>
      <div class="media__decoWrapper rb-decoWrapper" aria-hidden="true">
        <span class="b-deco b-deco-star b-deco-a">★</span>
        <span class="b-deco b-deco-star b-deco-b">★</span>
      </div>
      <div class="b-wrap rb-content-container media-container">
        <div>
          <hgroup class="rb-content_title">
            <p class="b-side-num">Side 03 / 03</p>
            <h2 class="b-side-title">The <span>Media</span></h2>
            <p class="b-side-desc">YouTube videos, tutorials, commentary, projects — an episode library, not an embed page. The videos land here when the vlog starts.</p>
            <p class="rb-content_title--txt"><span>RetailBo</span></p>
          </hgroup>
          <MediaLibrary variant="home" />
        </div>
      </div>
    </section>
    <Marquee />

    <ToolsShelf />

    <!-- ═══ SPONSORED ═══ -->
    <section class="band rb-content rb-content--sponsored" data-section="sponsored" id="b-sponsored">
      <div class="sponsored_grad rb-grad" aria-hidden="true"></div>
      <div class="rb-contPtnBg_wrapper" aria-hidden="true"><div class="rb-contPtnBg"></div></div>
      <div class="sponsored__decoWrapper rb-decoWrapper" aria-hidden="true">
        <span class="b-deco b-deco-usd b-deco-a">$</span>
        <span class="b-deco b-deco-star b-deco-b">★</span>
      </div>
      <div class="b-wrap rb-content-container sponsored-container">
        <div>
          <hgroup class="rb-content_title">
            <p class="b-kicker">
              <span class="b-chip">Sponsored</span>
              <span class="b-date">Ads</span>
            </p>
            <h2 class="b-h">Sponsored</h2>
            <p class="rb-content_title--txt"><span>RetailBo</span></p>
          </hgroup>
          <p class="b-lede">The promos are the ads — the content stays free.</p>
          <Sponsored />
        </div>
      </div>
    </section>

    <Ticker items={tickerLines} />

    <!-- ═══ SIGN-OFF ═══ -->
    <section class="band rb-content rb-content--signoff" data-section="signoff" id="b-signoff">
      <div class="signoff_grad rb-grad" aria-hidden="true"></div>
      <div class="rb-contPtnBg_wrapper" aria-hidden="true"><div class="rb-contPtnBg"></div></div>
      <div class="signoff__decoWrapper rb-decoWrapper" aria-hidden="true">
        <span class="b-deco b-deco-star b-deco-a">★</span>
        <span class="b-deco b-deco-star b-deco-b">★</span>
      </div>
      <div class="b-wrap rb-content-container signoff-container">
        <div>
          <hgroup class="rb-content_title signoff_title">
            <h2 class="rb-signoff-h">Chart City → Moon World</h2>
            <p class="rb-content_title--txt"><span>RetailBo</span></p>
          </hgroup>
          <FooterSurprise />
        </div>
      </div>
      <SignoffFooter />
      <LoopBand />
      <LossCut />
    </section>
          </div>
        </div>
        <RailChart />
      </div>

      <HomeScripts />
    </div>
  </div>
</Layout>
