---
import Layout from '../../layouts/Layout.astro';
import SiteGlow from '../../components/SiteGlow.astro';
import Navbar from '../../components/Navbar.astro';
import AskRb from '../../components/AskRb.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { postSlug, readingTime } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Related: posts sharing a tag, newest first, excluding this one.
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter((p) => postSlug(p) !== postSlug(post))
  .filter((p) => p.data.tags.some((t) => post.data.tags.includes(t)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

function fmt(d: Date): string {
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<Layout
  title={`130 AM // ${post.data.title}`}
  description={post.data.description}
  active="blog"
>
  <SiteGlow />
  <Navbar active="blog" />
  <AskRb />

  <main class="wrap pt-10 pb-4" style="max-width: 680px;">
    <div class="stack">
      <div class="reveal">
        <a
          href="/blog/"
          class="mono"
          style="font-size: 10px; letter-spacing: 0.18em; color: var(--ink-faint); min-height: 44px; display: inline-flex; align-items: center;"
        >
          ← BACK TO THE RANT ROOM
        </a>
      </div>

      <header class="reveal">
        <div class="flex items-center gap-3 mb-4 flex-wrap">
          <span class="sticker sticker-amber">{post.data.category}</span>
          <time
            class="mono"
            style="font-size: 10px; color: var(--ink-faint); letter-spacing: 0.14em;"
            datetime={post.data.date.toISOString().slice(0, 10)}
          >
            {fmt(post.data.date)} · {readingTime(post)} min read
          </time>
        </div>
        <h1 class="hand" style="font-size: 2.6rem; line-height: 1.1;">{post.data.title}</h1>
        <p class="note mt-3" style="font-size: 1.15rem;">{post.data.description}</p>
      </header>

      <article class="card tape reveal prose-room">
        <Content />
        <p class="hand mt-8" style="font-size: 1.6rem; color: var(--ink-dim);">— Bo</p>
      </article>

      {post.data.tags.length > 0 && (
        <div class="reveal flex items-center gap-2 flex-wrap">
          {post.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}

      {related.length > 0 && (
        <section class="reveal" aria-label="Related rants">
          <h2 class="display display-md mb-4">keep reading</h2>
          <div class="flex flex-col gap-3">
            {related.map((r) => (
              <a href={`/blog/${postSlug(r)}/`} class="card card-flat block" style="padding: 16px 18px;">
                <div class="flex items-center gap-3 mb-1 flex-wrap">
                  <span class="sticker sticker-sky">{r.data.category}</span>
                  <span class="mono" style="font-size: 10px; color: var(--ink-faint);">
                    {readingTime(r)} min read
                  </span>
                </div>
                <p class="hand" style="font-size: 1.4rem; line-height: 1.2;">{r.data.title}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      <div class="reveal flex items-center justify-between flex-wrap gap-3">
        <a
          href="/blog/"
          class="btn btn-ghost"
        >
          ← more rants
        </a>
        <p class="note" style="font-size: 1.1rem; color: var(--ink-faint);">— from the room 🌙</p>
      </div>
    </div>
  </main>

  <Footer />

  <style>
    /* Handwritten display type */
    .hand {
      font-family: var(--font-hand);
      font-weight: 500;
      color: var(--ink);
    }
    /* Long-form reading styles — warm, roomy, mobile-first. */
    .prose-room {
      font-family: var(--font-body);
      font-size: 1.02rem;
      line-height: 1.75;
      color: var(--ink-dim);
    }
    .prose-room > *:first-child { margin-top: 0; }
    .prose-room > *:last-child { margin-bottom: 0; }
    .prose-room p { margin: 1.1em 0; }
    .prose-room h2, .prose-room h3 {
      font-family: var(--font-display);
      color: var(--ink);
      line-height: 1.3;
      margin: 1.6em 0 0.6em;
    }
    .prose-room h2 { font-size: 1.35rem; }
    .prose-room h3 { font-size: 1.15rem; }
    .prose-room ul, .prose-room ol { margin: 1.1em 0; padding-left: 1.4em; }
    .prose-room li { margin: 0.45em 0; }
    .prose-room li::marker { color: var(--amber); }
    .prose-room strong { color: var(--ink); }
    .prose-room em { color: var(--ink); }
    /* Pull quotes — handwritten, the room's voice marking up the margins. */
    .prose-room blockquote {
      margin: 1.6em 0;
      padding: 0.4em 0 0.4em 1.1em;
      border-left: 3px solid var(--amber);
      font-family: var(--font-hand);
      font-size: 1.45rem;
      line-height: 1.35;
      color: var(--ink);
    }
    .prose-room blockquote p { margin: 0.3em 0; }
    .prose-room code {
      font-family: var(--font-mono);
      font-size: 0.88em;
      background: rgba(255, 176, 0, 0.1);
      padding: 0.15em 0.4em;
      border-radius: 6px;
      color: var(--amber);
    }
    .prose-room pre {
      background: #0f0b07;
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 1em 1.2em;
      overflow-x: auto;
      margin: 1.4em 0;
    }
    .prose-room pre code {
      background: none;
      padding: 0;
      color: var(--ink-dim);
    }
    .prose-room a { color: var(--amber); text-decoration: underline; text-underline-offset: 3px; }
    .prose-room hr {
      border: none;
      border-top: 1px dashed var(--card-border);
      margin: 2em 0;
    }
    /* Yellow marker highlight, usable inline in posts */
    .prose-room mark, .hl {
      background: linear-gradient(100deg, rgba(255, 213, 74, 0.32), rgba(255, 213, 74, 0.2));
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
      padding: 0 3px;
      border-radius: 2px;
      color: var(--ink);
    }
  </style>
</Layout>
