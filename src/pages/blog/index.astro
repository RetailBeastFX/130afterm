---
import Layout from '../../layouts/Layout.astro';
import SiteGlow from '../../components/SiteGlow.astro';
import Navbar from '../../components/Navbar.astro';
import AskRb from '../../components/AskRb.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { postSlug, sortNewest, readingTime } from '../../lib/blog';

// THE RANT ROOM — Bo's personal blog. Thoughts, rants, whatever's on his mind.
// Drafts are excluded from the listing.
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(sortNewest);

function fmt(d: Date): string {
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

const accents = ['sticker-amber', 'sticker-rose', 'sticker-sky', 'sticker-mint', 'sticker-violet'];
---

<Layout
  title="RetailBo // the rant room"
  description="Bo's personal blog — thoughts, rants, and whatever's on his mind. Unedited on purpose."
  active="blog"
>
  <SiteGlow />
  <Navbar active="blog" />
  <AskRb />

  <main class="wrap pt-10 pb-4">
    <div class="stack">
      <header class="reveal">
        <span class="label">// the blog</span>
        <h1 class="display display-lg mt-2">the rant room</h1>
        <p class="note mt-2">thoughts & rants, unedited on purpose 📝</p>
        <p class="body-dim text-sm mt-4 max-w-md">
          whatever's on Bo's mind. no curriculum, no lessons — just the person, thinking out loud.
        </p>
      </header>

      <!-- Category filter — the five shelves, plus Relationships as written -->
      <div class="reveal flex gap-2 flex-wrap" role="group" aria-label="Filter by category" id="cat-filter">
        {['All', 'Life', 'Mindset', 'Society', 'Money', 'Trading', 'Relationships'].map((cat) => (
          <button
            type="button"
            class:list={['cat-chip', { active: cat === 'All' }]}
            data-cat={cat}
            aria-pressed={cat === 'All' ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>

      {posts.length > 0 ? (
        <div class="flex flex-col gap-4" id="blog-list">
          {posts.map((post, i) => (
            <a
              href={`/blog/${postSlug(post)}/`}
              class={`card block reveal ${i % 2 === 0 ? 'tape' : 'tape tape-sky'}`}
              data-category={post.data.category}
            >
              <div class="flex items-center gap-3 mb-3 flex-wrap">
                <span class:list={['sticker', accents[i % accents.length]]}>
                  {post.data.category}
                </span>
                <time
                  class="mono"
                  style="font-size: 10px; color: var(--ink-faint); letter-spacing: 0.14em;"
                  datetime={post.data.date.toISOString().slice(0, 10)}
                >
                  {fmt(post.data.date)} · {readingTime(post)} min read
                </time>
              </div>
              <h2 class="hand mb-3" style="font-size: 1.9rem; line-height: 1.15;">{post.data.title}</h2>
              {post.data.highlight ? (
                <p class="text-sm leading-relaxed mb-2">
                  <mark class="hl">{post.data.highlight}</mark>
                </p>
              ) : (
                <p class="body-dim text-sm mb-2">{post.data.description}</p>
              )}
              <span
                class="mono mt-2 inline-block"
                style="font-size: 10px; letter-spacing: 0.18em; color: var(--amber);"
              >
                READ →
              </span>
            </a>
          ))}
        </div>
      ) : (
        <div class="card reveal">
          <p class="body-faint text-sm">nothing on the desk yet. check back at the opens.</p>
        </div>
      )}
    </div>
  </main>

  <Footer />

  <script>
    // Category filter — client-side, no reload. Server renders everything.
    (function () {
      var chips = Array.prototype.slice.call(document.querySelectorAll('#cat-filter .cat-chip'));
      var cards = Array.prototype.slice.call(document.querySelectorAll('#blog-list [data-category]'));
      if (!chips.length || !cards.length) return;
      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          var cat = chip.getAttribute('data-cat');
          chips.forEach(function (c) {
            var on = c === chip;
            c.classList.toggle('active', on);
            c.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
          cards.forEach(function (card) {
            var show = cat === 'All' || card.getAttribute('data-category') === cat;
            card.style.display = show ? '' : 'none';
          });
        });
      });
    })();
  </script>
</Layout>

<style>
  /* Handwritten post titles */
  .hand {
    font-family: var(--font-hand);
    font-weight: 500;
    color: var(--ink);
  }
</style>
