// Homepage scroll engine — one rAF-throttled handler driving the two
// scroll-linked mechanisms from the Blue sampler: the discrete rail
// chart (right rail — 24 small candles, parallax-slow, filling as you
// scroll; red printing down, green printing up, flipping in real time
// with scroll direction; the one caption bubble rides the frontier
// and speaks for the section in view) and the LIQUIDATED loss-cut
// veil/splash. Plus the .b-reveal IntersectionObserver. (The
// full-page background chart rows are CUT — v32 — so there is no
// bg-parallax here anymore; the chart lives only in the rail.)
// Progress for the article-progress widget lives in Widgets.astro.
---

<script>
  (function () {
    var reduceMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var blueSite = document.querySelector('.blue-site');

    // ── Discrete rail chart (right rail) ───────────────────────────
    // The rail chart's print layer is a clone of the authored ghost
    // candles — same candles, recoloured by the scroll direction's
    // colour family in CSS and clipped to progress.
    var railGhost = document.getElementById('bRailGhost');
    var railPrintEl = document.getElementById('bRailPrint');
    if (railGhost && railPrintEl) { railPrintEl.innerHTML = railGhost.innerHTML; }
    // The per-section captions — the same words the sections used to
    // float in their own chart layers, now spoken one at a time by
    // the rail bubble, anchored to the frontier.
    var railCaptions = {
      hero: 'there\u2019s the move \u2191',
      latest: 'just dropped',
      journey: 'swept the lows\u2026 then broke out',
      lab: 'slow grind',
      indicator: 'uh-oh\u2026',
      man: 'back from the dead',
      media: 'flipped it',
      shelf: 'the whole shelf',
      sponsored: 'step by step',
      signoff: 'run it up \u2191',
    };
    var railBubble = document.getElementById('bRailBubble');
    var railCaptionNow = '';
    function updateRailCaption(vh) {
      if (!railBubble || !blueSite) return;
      var secs = blueSite.querySelectorAll('.rb-content');
      var mid = vh * 0.45;
      var key = 'hero';
      for (var i = 0; i < secs.length; i++) {
        if (secs[i].getBoundingClientRect().top <= mid) {
          key = secs[i].getAttribute('data-section') || key;
        } else {
          break;
        }
      }
      var txt = railCaptions[key];
      if (txt && txt !== railCaptionNow) {
        railCaptionNow = txt;
        railBubble.textContent = txt;
      }
    }
    var railPrint = document.getElementById('bRailPrint');
    var railSticky = document.getElementById('bRailSticky');
    var candleDown = true; // initial = bearish / scrolling down
    var lastCandleDone = null;
    function updateRail() {
      if (!railPrint || !railSticky || !blueSite) return;
      var vh = window.innerHeight || 800;
      // Holder follow: the sticky-in-effect holder is moved 1:1 with
      // scroll so the chart stays at the edge of view for the whole
      // trip (positioning, not animation — it runs under reduced
      // motion too; only the print clip is released there).
      var railAside = railSticky.parentNode;
      if (railAside) {
        var ar = railAside.getBoundingClientRect();
        var follow = Math.min(Math.max(-ar.top, 0), Math.max(ar.height - vh, 0));
        var followT = follow > 0 ? 'translate3d(0,' + follow.toFixed(1) + 'px,0)' : '';
        if (railSticky.style.transform !== followT) { railSticky.style.transform = followT; }
      }
      // The glowing frontier sits at overall scroll progress (--rp on
      // the sticky holder drives the frontier line, the caption bubble
      // and the column's slow parallax drift in CSS). Which side of
      // the frontier is printed — and the printed candles' colour —
      // follows the scroll direction: scrolling down, the print layer
      // is clipped from the top (bearish red, printing downward);
      // scrolling up, it is clipped from the bottom so the printed
      // part grows upward from the foot of the chart (bullish green).
      // The .is-bull / .is-bear classes swap the --sc colour family
      // in CSS. Scroll-linked only — this runs on scroll/resize,
      // never on a timer. Reduced motion pins it fully printed in
      // its default bearish red (the CSS clip release agrees).
      var railRect = blueSite.getBoundingClientRect();
      var railTotal = Math.max(railRect.height - vh, 1);
      var railDone = Math.min(Math.max(-railRect.top, 0), railTotal);
      if (lastCandleDone !== null) {
        if (railDone > lastCandleDone + 0.5) { candleDown = true; }
        else if (railDone < lastCandleDone - 0.5) { candleDown = false; }
      }
      lastCandleDone = railDone;
      var railP = railDone / railTotal;
      railSticky.style.setProperty('--rp', railP.toFixed(4));
      if (reduceMotion) {
        railPrint.style.clipPath = 'inset(0 0 0% 0)';
        railSticky.classList.remove('is-bull');
        railSticky.classList.add('is-bear');
        railSticky.setAttribute('data-dir', 'down');
        railSticky.style.setProperty('--tip-o', '0');
      } else if (candleDown) {
        railPrint.style.clipPath = 'inset(0 0 ' + ((1 - railP) * 100).toFixed(2) + '% 0)';
        railSticky.classList.remove('is-bull');
        railSticky.classList.add('is-bear');
        railSticky.setAttribute('data-dir', 'down');
        railSticky.style.setProperty('--tip-o', railP > 0.001 && railP < 0.999 ? '1' : '0');
      } else {
        railPrint.style.clipPath = 'inset(' + (railP * 100).toFixed(2) + '% 0 0 0)';
        railSticky.classList.remove('is-bear');
        railSticky.classList.add('is-bull');
        railSticky.setAttribute('data-dir', 'up');
        railSticky.style.setProperty('--tip-o', railP > 0.001 && railP < 0.999 ? '1' : '0');
      }
      updateRailCaption(vh);
    }

    // ── LIQUIDATED loss-cut ─────────────────────────────────────────
    var lossZone = document.getElementById('bLossZone');
    var lossNavy = document.getElementById('bLossNavy');
    var lossBlack = document.getElementById('bLossBlack');
    var lossSplash = document.getElementById('bLossSplash');
    var lossSplashing = false;
    var lossArmed = true;
    function setLossVeil(navyO, blackO) {
      if (lossNavy) lossNavy.style.opacity = navyO.toFixed(3);
      if (lossBlack) lossBlack.style.opacity = blackO.toFixed(3);
    }
    function fireLossSplash() {
      lossSplashing = true;
      lossArmed = false;
      if (lossSplash) lossSplash.classList.add('on');
      window.setTimeout(function () {
        if (lossSplash) lossSplash.classList.remove('on');
        setLossVeil(0, 0);
        var topEl = document.getElementById('b-top');
        var doc = document.documentElement;
        var prevBehavior = doc.style.scrollBehavior;
        doc.style.scrollBehavior = 'auto';
        if (topEl) {
          window.scrollTo(0, topEl.getBoundingClientRect().top + (window.pageYOffset || 0));
        } else {
          window.scrollTo(0, 0);
        }
        doc.style.scrollBehavior = prevBehavior;
        lossSplashing = false;
      }, 3000);
    }
    function updateLossCut() {
      if (!lossZone || !lossSplash) return;
      if (lossSplashing) return;
      if (reduceMotion) {
        setLossVeil(0, 0);
        return;
      }
      var vh = window.innerHeight || 800;
      var zr = lossZone.getBoundingClientRect();
      var zoneH = lossZone.offsetHeight || vh * 1.2;
      var entered = vh - zr.top;
      var p = entered / (zoneH * 0.9);
      if (p < 0) p = 0;
      if (p > 1) p = 1;
      if (p < 0.4) lossArmed = true;
      var navyO = Math.min(p / 0.38, 1);
      var blackO = Math.min(Math.max((p - 0.42) / 0.33, 0), 1);
      setLossVeil(navyO, blackO);
      if (p >= 0.9 && lossArmed) fireLossSplash();
    }

    // ── One rAF-throttled scroll/resize handler ──────────────────────
    var ticking = false;
    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(function () {
          ticking = false;
          updateRail();
          updateLossCut();
        });
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    onScroll();

    // ── Reveal-on-scroll (.b-reveal) — legibility-safe: elements sit
    // at full opacity by default; only "armed" ones fade, the observer
    // completes them to 100%, and a 4s safety forces .in ──────────
    var revealEls = document.querySelectorAll('.b-reveal');
    if ('IntersectionObserver' in window && !reduceMotion) {
      Array.prototype.forEach.call(revealEls, function (el) {
        el.classList.add('armed');
      });
      var revealIO = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) {
              en.target.classList.add('in');
              revealIO.unobserve(en.target);
            }
          });
        },
        { threshold: 0.05, rootMargin: '0px 0px 30% 0px' }
      );
      Array.prototype.forEach.call(revealEls, function (el) {
        revealIO.observe(el);
      });
      window.setTimeout(function () {
        Array.prototype.forEach.call(revealEls, function (el) {
          el.classList.add('in');
        });
      }, 4000);
    } else {
      Array.prototype.forEach.call(revealEls, function (el) {
        el.classList.add('in');
      });
    }

    // ── Characters — folder tabs (Bo / Beast) ───────────────────────
    var castTabs = document.querySelectorAll('.b-cast-tab');
    var castPanels = document.querySelectorAll('.b-cast-panel');
    Array.prototype.forEach.call(castTabs, function (tab) {
      tab.addEventListener('click', function () {
        Array.prototype.forEach.call(castTabs, function (t) {
          var on = t === tab;
          t.classList.toggle('is-on', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        Array.prototype.forEach.call(castPanels, function (p) {
          if (p.getAttribute('aria-labelledby') === tab.id) {
            p.removeAttribute('hidden');
          } else {
            p.setAttribute('hidden', '');
          }
        });
      });
    });
  })();
</script>
