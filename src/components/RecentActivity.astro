---
import type { ActivityEvent } from '../types/activity';

interface Props {
  events: ActivityEvent[];
}

const { events } = Astro.props;

const TYPE_ICON: Record<string, string> = {
  trade:   '📈',
  build:   '🔧',
  media:   '🎬',
  life:    '🌙',
  gaming:  '🎮',
  stream:  '📡',
  thought: '💭',
  project: '⚡',
};

function relativeDate(dateStr: string): string {
  const diff = Math.floor(
    (Date.now() - new Date(dateStr).getTime()) / 86_400_000
  );
  if (diff === 0) return 'today';
  if (diff === 1) return 'yesterday';
  if (diff < 7)  return `${diff}d ago`;
  return dateStr;
}
---

<div class="recent-activity">
  {events.map((event) => (
    <div class="ra-row" data-type={event.type}>
      <span class="ra-icon" aria-hidden="true">{TYPE_ICON[event.type] ?? '·'}</span>
      <div class="ra-body">
        <div class="ra-title">
          {event.href
            ? <a href={event.href}>{event.title}</a>
            : event.title}
        </div>
        {event.summary && <div class="ra-summary">{event.summary}</div>}
      </div>
      <time class="ra-date" datetime={event.date}>{relativeDate(event.date)}</time>
    </div>
  ))}

  <a href="/archive" class="ra-more">
    View full archive →
  </a>
</div>

<style>
  .recent-activity {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ra-row {
    display: grid;
    grid-template-columns: 20px 1fr auto;
    gap: 0.6rem;
    align-items: start;
    padding: 0.65rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }

  .ra-row:last-of-type {
    border-bottom: none;
  }

  .ra-icon {
    font-size: 0.75rem;
    margin-top: 1px;
    line-height: 1;
  }

  .ra-body {
    min-width: 0;
  }

  .ra-title {
    font-size: 0.78rem;
    font-weight: 600;
    color: #e4e4e7;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
  }

  .ra-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s;
  }

  .ra-title a:hover {
    color: #ffb000;
  }

  .ra-summary {
    font-size: 0.68rem;
    color: #52525b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 0.15rem;
    font-family: var(--font-mono, monospace);
  }

  .ra-date {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    color: #3f3f46;
    white-space: nowrap;
    padding-top: 2px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ra-more {
    display: block;
    margin-top: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    color: #ffb000;
    text-decoration: none;
    letter-spacing: 0.08em;
    opacity: 0.7;
    transition: opacity 0.15s;
  }

  .ra-more:hover {
    opacity: 1;
  }
</style>
