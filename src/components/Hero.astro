---
// Dual-world hero — Chart City (the market) / Moon World (the man).
// Instant flip, no reload, remembers the mode in the URL hash.
// Moon mood is quieter and more atmospheric: dimmer, less saturated.
// Hinge-aware: dual-screen segments get one panel each, with fallback.
// Sampler frame: retro OS-window title bar on the card + Kurumi-style
// SCROLL cue at the bottom of the hero.
import ChartRow from './ChartRow.astro';
---
<section class="hero rb-content rb-content--hero" id="b-hero" data-section="hero" data-mood="market" aria-label="RetailBo — two worlds">
  <div class="hero_grad rb-grad" aria-hidden="true"></div>
  <div class="rb-contPtnBg_wrapper" aria-hidden="true"><div class="rb-contPtnBg"></div></div>
  <ChartRow row="hero" />
  <div class="hero__decoWrapper rb-decoWrapper" aria-hidden="true">
    <span class="b-deco b-deco-star b-deco-a">★</span>
    <span class="b-deco b-deco-star b-deco-b">★</span>
  </div>
  <div class="hero-art" aria-hidden="true">
    <img
      class="hero-img-market"
      src="/assets/hero-chart-city.webp"
      alt=""
      width="1170"
      height="658"
      fetchpriority="high"
    />
    <img
      class="hero-img-moon"
      src="/assets/hero-moon.webp"
      alt=""
      width="1170"
      height="780"
      fetchpriority="high"
      style="position: absolute; inset: 0;"
    />
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow">RetailBo — a place, not just a brand</p>

      <div class="hero-copy-market">
        <p class="hero-bubble">my journey into wealth</p>
        <p class="hero-pill-line"><span class="hero-pill teal">★ Personal, but trading ★</span></p>
        <h1 class="logo-text hero-title">Retail<span class="accent">Bo</span></h1>
        <p class="hero-headline">Documenting my struggle to success</p>
        <p class="hero-sub">
          My research and everything you find here — all of it in one place,
          before I start vlogging about it.
        </p>
        <div class="hero-meta">
          <span class="hero-pill yellow">★ EST. 2017</span>
          <img
            class="hero-rb"
            src="/assets/rb-pointing.gif"
            alt="RB, the Retail Beast — compact black and gunmetal armor, neon-green horns, glowing green eyes, green circuit accents — animated: bobbing gently, eyes pulsing, pointing at you with a green wrench in his other hand."
            width="92"
            height="138"
            loading="lazy"
          />
        </div>
      </div>

      <div class="hero-copy-moon" hidden>
        <h1 class="logo-text hero-title">Retail<span class="accent">Bo</span></h1>
        <p class="hero-tag">the man behind the charts</p>
        <p class="hero-sub">
          the man — thoughts, life, mindset, family. the perspective behind
          the name. same person, quieter energy. this is the side of the
          site where the market goes silent and the person talks.
        </p>
      </div>
    </div>

    <div class="hero-card">
      <div class="b-hero-winbar">
        <span class="wdot a"></span><span class="wdot b"></span><span class="wdot c"></span>
        <span class="b-hero-winbar-title">RETAILBO — HOME</span>
        <span class="b-win-ctl" aria-hidden="true"><i>–</i><i>□</i><i>×</i></span>
      </div>
      <h2 id="hero-card-title">The market is open.</h2>
      <p id="hero-card-body">
        9:30 RTH, Asia, London — the opens are where the day is decided.
        the blog is where the market and the man meet.
      </p>
      <div class="hero-pills" aria-label="Market opens">
        <span class="hero-pill green">▲ 9:30 RTH · NEW YORK</span>
        <span class="hero-pill">9:00 ASIA OPEN · TOKYO</span>
        <span class="hero-pill">8:00 LONDON OPEN</span>
      </div>

      <p class="hero-switch-label">Two moods</p>
      <div class="hero-switcher" role="group" aria-label="Switch worlds">
        <button
          type="button"
          class="hero-thumb"
          id="mood-market"
          aria-pressed="true"
          data-mood="market"
        >
          <img src="/assets/chart-city-skyline.webp" alt="" width="1170" height="658" />
          <span>
            <span class="ht-label">The market</span>
            <span class="ht-sub">chart city · energy</span>
          </span>
        </button>
        <button
          type="button"
          class="hero-thumb"
          id="mood-moon"
          aria-pressed="false"
          data-mood="moon"
        >
          <img src="/assets/moon-base.webp" alt="" width="1170" height="658" />
          <span>
            <span class="ht-label">The moon</span>
            <span class="ht-sub">moon world · quiet</span>
          </span>
        </button>
      </div>
    </div>
  </div>

  <a class="b-scroll-cue" href="#b-now" aria-label="Scroll down to the next section">
    <span class="b-scroll-cue-label">SCROLL</span>
    <svg class="b-scroll-cue-arrow" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9l8 8 8-8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </a>
</section>

<script>
  (function () {
    var hero = document.getElementById('b-hero');
    if (!hero) return;
    var marketCopy = hero.querySelector('.hero-copy-market');
    var moonCopy = hero.querySelector('.hero-copy-moon');
    var cardTitle = document.getElementById('hero-card-title');
    var cardBody = document.getElementById('hero-card-body');
    var marketBtn = document.getElementById('mood-market');
    var moonBtn = document.getElementById('mood-moon');

    var CARD = {
      market: {
        title: 'The market is open.',
        body: '9:30 RTH, Asia, London — the opens are where the day is decided. the blog is where the market and the man meet.',
      },
      moon: {
        title: 'The room goes quiet.',
        body: 'same site, different energy. the moon is Bo outside the market — the thoughts, experiences, and perspective behind the name.',
      },
    };

    function setMood(mood, persist) {
      if (mood !== 'moon') mood = 'market';
      hero.setAttribute('data-mood', mood);
      // Site-wide moon dimming (marquee, gutter, widgets) keys off the body.
      try { document.body.setAttribute('data-mood', mood); } catch (e) {}
      if (marketCopy) marketCopy.hidden = mood !== 'market';
      if (moonCopy) moonCopy.hidden = mood !== 'moon';
      if (marketBtn) marketBtn.setAttribute('aria-pressed', mood === 'market' ? 'true' : 'false');
      if (moonBtn) moonBtn.setAttribute('aria-pressed', mood === 'moon' ? 'true' : 'false');
      if (cardTitle) cardTitle.textContent = CARD[mood].title;
      if (cardBody) cardBody.textContent = CARD[mood].body;
      if (persist) {
        try {
          history.replaceState(null, '', '#mood=' + mood);
        } catch (e) {}
      }
    }

    var initial = 'market';
    try {
      var m = (location.hash || '').match(/mood=(moon|market)/);
      if (m) initial = m[1];
    } catch (e) {}
    setMood(initial, false);

    if (marketBtn) marketBtn.addEventListener('click', function () { setMood('market', true); });
    if (moonBtn) moonBtn.addEventListener('click', function () { setMood('moon', true); });
  })();
</script>
