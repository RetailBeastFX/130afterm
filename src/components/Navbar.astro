---
interface Props {
  active?: string;
}

const { active = 'home' } = Astro.props;

const links = [
  { key: 'home', href: '/', label: 'home', no: '01' },
  { key: 'now', href: '/now', label: 'now', no: '02' },
  { key: 'archive', href: '/archive', label: 'archive', no: '03' },
  { key: 'links', href: '/links', label: 'links', no: '04' },
  { key: 'terminal', href: '/terminal', label: 'terminal', no: '05' },
];
---

<nav class="site-nav" aria-label="Site navigation">
  <div class="wrap flex items-center justify-between gap-4 py-2">
    <a href="/" class="flex items-center gap-3 min-h-[48px]" aria-label="130 AM home">
      <span
        class="flex items-center justify-center w-9 h-9 rounded-xl text-sm font-bold"
        style="background: var(--amber); color: #241a05; font-family: var(--font-display);"
        aria-hidden="true"
      >
        1:30
      </span>
      <span class="leading-tight">
        <span class="display block text-lg">130 AM</span>
        <span class="label block" style="font-size: 8px;">// after hours.</span>
      </span>
    </a>

    <div class="nav-links items-center gap-1" role="list">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={['nav-link', { active: active === l.key }]}
          aria-current={active === l.key ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
    </div>

    <button
      class="nav-burger"
      id="nav-burger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="menu-overlay"
    >
      ☰
    </button>
  </div>
</nav>

<div class="menu-overlay" id="menu-overlay" role="dialog" aria-modal="true" aria-label="Menu">
  <button class="menu-close" id="menu-close" aria-label="Close menu">✕</button>
  <nav class="mt-6" aria-label="Mobile navigation">
    {links.map((l) => (
      <a href={l.href} class="menu-link">
        <span class="menu-no">{l.no}</span>
        <span>{l.label}</span>
      </a>
    ))}
  </nav>
  <p class="note mt-auto text-center body-faint" style="font-size: 1.1rem; color: var(--ink-faint);">
    1:30 after midnight. the hour noise stops.
  </p>
</div>

<script>
  (function () {
    var burger = document.getElementById('nav-burger');
    var overlay = document.getElementById('menu-overlay');
    var close = document.getElementById('menu-close');
    if (!burger || !overlay || !close) return;

    function setOpen(open) {
      overlay.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) close.focus();
    }

    burger.addEventListener('click', function () { setOpen(true); });
    close.addEventListener('click', function () { setOpen(false); });
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) setOpen(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>
