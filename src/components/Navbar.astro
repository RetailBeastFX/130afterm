---
// Minimal nav — the header is just the RetailBo wordmark + one round
// MENU button (identical desktop and mobile, no horizontal link bar).
// The slide-in panel lists all thirteen destinations in page order;
// homepage sections smooth-scroll, real pages navigate. Kurumi-style:
// the MENU button opens a right-side drawer, like fxkurumi-info.com.
// (The Media entry was removed Nov 27 — the episode library is out
// until Bo starts uploading; restore it with the Media section.)
interface Props {
  active?: string;
}

const { active = 'home' } = Astro.props;

const links = [
  { key: 'home', href: '/#b-top', label: 'Home' },
  { key: 'latest', href: '/#b-latest', label: 'Latest' },
  { key: 'market', href: '/#b-market', label: 'The Market' },
  { key: 'man', href: '/#b-man', label: 'The Man' },
  { key: 'shelf', href: '/#b-shelf', label: 'Shelf' },
  { key: 'sponsored', href: '/#b-sponsored', label: 'Sponsored' },
  { key: 'blog', href: '/blog', label: 'Rants' },
  { key: 'lab', href: '/lab', label: 'Lab' },
  { key: 'journal', href: '/journal', label: 'Journal' },
  { key: 'now', href: '/now', label: 'Now' },
  { key: 'links', href: '/links', label: 'Links' },
  { key: 'archive', href: '/archive', label: 'Archive' },
  { key: 'terminal', href: '/terminal', label: 'Terminal' },
];
---

<header class="b-head" id="b-top">
  <a href="/" class="b-wordmark" aria-label="RetailBo home">Retail<span>Bo</span></a>
  <button
    class="b-menu-btn"
    id="bMenuBtn"
    type="button"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="bPanel"
  >
    MENU
  </button>
  <div class="b-scrim" id="bScrim" aria-hidden="true"></div>
  <nav class="b-panel" id="bPanel" aria-label="Site menu">
    <button class="b-panel-close" id="bPanelClose" type="button" aria-label="Close menu">×</button>
    <p class="b-panel-title">★ MENU</p>
    <div class="b-panel-nav">
      {
        links.map((l) => (
          <a href={l.href} aria-current={active === l.key ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </div>
    <p class="b-panel-note">Personal, but trading.</p>
  </nav>
</header>

<script>
  (function () {
    var menuBtn = document.getElementById('bMenuBtn');
    var panelClose = document.getElementById('bPanelClose');
    var scrim = document.getElementById('bScrim');
    if (!menuBtn || !panelClose || !scrim) return;

    function setNav(open) {
      document.body.classList.toggle('nav-open', open);
      menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    menuBtn.addEventListener('click', function () { setNav(true); });
    panelClose.addEventListener('click', function () { setNav(false); });
    scrim.addEventListener('click', function () { setNav(false); });
    Array.prototype.forEach.call(
      document.querySelectorAll('.b-panel-nav a'),
      function (a) {
        a.addEventListener('click', function (e) {
          // Homepage sections smooth-scroll without a reload when we
          // are already on the homepage; from any other page the link
          // navigates to /#anchor normally.
          var href = a.getAttribute('href') || '';
          if (href.indexOf('/#') === 0 && window.location.pathname === '/') {
            e.preventDefault();
            var el = document.getElementById(href.slice(2));
            if (el) el.scrollIntoView({ behavior: 'smooth' });
            else window.scrollTo({ top: 0, behavior: 'smooth' });
          }
          setNav(false);
        });
      }
    );
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setNav(false);
    });
  })();
</script>
