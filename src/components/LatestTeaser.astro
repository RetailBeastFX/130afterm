---
// Latest teaser — the three real Nov 15 posts with their real /blog/
// links, Kurumi News-style. Short-rally parallax row, caption
// "just dropped". Sampler copy, verbatim.
import ChartRow from './ChartRow.astro';
---

<section class="b-band rb-content rb-content--latest" data-section="latest" id="b-latest">
  <div class="latest_grad rb-grad" aria-hidden="true"></div>
  <div class="rb-contPtnBg_wrapper" aria-hidden="true"><div class="rb-contPtnBg"></div></div>
  <ChartRow row="latest" />
  <div class="latest__decoWrapper rb-decoWrapper" aria-hidden="true">
    <span class="b-deco b-deco-usd b-deco-a">$</span>
    <span class="b-deco b-deco-star b-deco-b">★</span>
  </div>
  <div class="rb-content-container latest-container">
    <div>
      <hgroup class="rb-content_title">
        <p class="b-kicker">
          <span class="b-chip">Latest</span>
          <span class="b-date">Nov 15, 2026</span>
        </p>
        <h2 class="b-h">Latest</h2>
        <p class="rb-content_title--txt"><span>RetailBo</span></p>
      </hgroup>
      <div class="b-oswin light off-b">
        <div class="b-win-bar">
          <span class="wdot a"></span><span class="wdot b"></span><span class="wdot c"></span>
          <span class="b-win-title">LATEST — NEWEST POSTS</span>
          <span class="b-win-ctl" aria-hidden="true"><i>–</i><i>□</i><i>×</i></span>
        </div>
        <div class="b-oswin-body">
          <ul class="b-news">
            <li>
              <a href="/blog/what-if-normal-wasnt-the-default/">
                <span class="b-news-date">2026.11.15</span>
                <span class="b-news-title">What If Normal Wasn’t the Default</span>
                <span class="b-news-arrow" aria-hidden="true">→</span>
              </a>
            </li>
            <li>
              <a href="/blog/the-birthday-that-changed-how-i-experience-being-alive/">
                <span class="b-news-date">2026.11.15</span>
                <span class="b-news-title">The Birthday That Changed How I Experience Being Alive</span>
                <span class="b-news-arrow" aria-hidden="true">→</span>
              </a>
            </li>
            <li>
              <a href="/blog/you-didnt-ask-to-be-here/">
                <span class="b-news-date">2026.11.15</span>
                <span class="b-news-title">You Didn’t Ask to Be Here</span>
                <span class="b-news-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          </ul>
          <div class="b-news-row">
            <a class="b-news-more" href="#b-archive">More <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
