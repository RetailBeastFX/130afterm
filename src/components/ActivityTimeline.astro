---
import type { ActivityEvent } from '../types/activity';

interface Props {
  events: ActivityEvent[];
  limit?: number;
}

const { events, limit = 100 } = Astro.props;
const visibleEvents = events.slice(0, limit);

const TYPE_META: Record<string, { icon: string; label: string; color: string }> = {
  trade:   { icon: '📈', label: 'trade',   color: '#f472a7' },
  build:   { icon: '🔧', label: 'build',   color: '#7dd3fc' },
  media:   { icon: '🎬', label: 'media',   color: '#fb923c' },
  life:    { icon: '🌙', label: 'life',    color: '#c4b5fd' },
  gaming:  { icon: '🎮', label: 'gaming',  color: '#c4b5fd' },
  stream:  { icon: '📡', label: 'stream',  color: '#f87171' },
  thought: { icon: '💭', label: 'thought', color: '#6ee7b7' },
  project: { icon: '⚡', label: 'project',  color: '#ffb000' },
};

function fmt(dateStr: string): string {
  const d = new Date(dateStr + 'T00:00:00');
  if (isNaN(d.getTime())) return dateStr;
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<section class="activity-timeline" aria-label="Activity archive">
  <div class="activity-timeline__list" id="archive-list">
    {visibleEvents.map((event) => {
      const meta = TYPE_META[event.type] ?? { icon: '·', label: event.type, color: '#8a7660' };
      return (
        <article class="card archive-card" data-type={event.type}>
          <div class="flex items-center gap-2 mb-2 flex-wrap">
            <span class="tag" style={`color: ${meta.color}; border-color: ${meta.color}44;`}>{meta.icon} {meta.label}</span>
            <time class="mono" style="font-size: 10px; color: var(--ink-faint); letter-spacing: 0.1em;" datetime={event.date}>
              {fmt(event.date)}{event.time ? ` · ${event.time}` : ''}
            </time>
          </div>
          <h3 class="font-bold" style="font-size: 1.02rem; line-height: 1.35;">
            {event.href ? <a href={event.href} class="archive-link">{event.title}</a> : event.title}
          </h3>
          {event.summary && <p class="text-sm body-faint mt-1.5">{event.summary}</p>}
          {event.tags?.length ? (
            <div class="flex flex-wrap gap-1.5 mt-3">
              {event.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          ) : null}
        </article>
      );
    })}
  </div>
</section>

<style>
  .activity-timeline__list {
    display: grid;
    gap: 14px;
  }
  .archive-card {
    padding: 18px 20px;
  }
  .archive-link {
    color: inherit;
  }
  @media (hover: hover) {
    .archive-link:hover { color: var(--amber); }
  }
</style>

<script>
  // Dynamic events from /api/activity (Netlify Blobs) — logged via the Terminal.
  // Prepended above the static entries. Same card shape, built client-side.
  async function loadDynamicEvents() {
    try {
      const res = await fetch('/api/activity');
      if (!res.ok) return;
      const events = await res.json();
      const list = document.getElementById('archive-list');
      if (!list || !events.length) return;

      const TYPE_COLORS = {
        trade: '#f472a7', build: '#7dd3fc', media: '#fb923c', life: '#c4b5fd',
        gaming: '#c4b5fd', stream: '#f87171', thought: '#6ee7b7', project: '#ffb000',
      };
      const TYPE_ICONS = {
        trade: '📈', build: '🔧', media: '🎬', life: '🌙',
        gaming: '🎮', stream: '📡', thought: '💭', project: '⚡',
      };

      function fmtDate(d) {
        const dt = new Date(d + 'T00:00:00');
        return isNaN(dt) ? d : dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      }

      function card(ev) {
        const color = TYPE_COLORS[ev.type] || '#8a7660';
        const icon = TYPE_ICONS[ev.type] || '·';
        const tags = (ev.tags || []).map(function (t) {
          var s = document.createElement('span');
          s.className = 'tag';
          s.textContent = t;
          return s.outerHTML;
        }).join('');

        var article = document.createElement('article');
        article.className = 'card archive-card';
        article.setAttribute('data-type', ev.type || '');

        var header = document.createElement('div');
        header.className = 'flex items-center gap-2 mb-2 flex-wrap';
        var tag = document.createElement('span');
        tag.className = 'tag';
        tag.style.color = color;
        tag.style.borderColor = color + '44';
        tag.textContent = icon + ' ' + (ev.type || 'note');
        var time = document.createElement('time');
        time.className = 'mono';
        time.style.fontSize = '10px';
        time.style.color = 'var(--ink-faint)';
        time.style.letterSpacing = '0.1em';
        time.setAttribute('datetime', ev.date || '');
        time.textContent = fmtDate(ev.date || '') + (ev.time ? ' · ' + ev.time : '');
        header.appendChild(tag);
        header.appendChild(time);

        var h3 = document.createElement('h3');
        h3.className = 'font-bold';
        h3.style.fontSize = '1.02rem';
        h3.style.lineHeight = '1.35';
        h3.textContent = ev.title || 'Untitled';

        article.appendChild(header);
        article.appendChild(h3);
        if (ev.summary) {
          var p = document.createElement('p');
          p.className = 'text-sm body-faint mt-1.5';
          p.textContent = ev.summary;
          article.appendChild(p);
        }
        if (tags) {
          var tagRow = document.createElement('div');
          tagRow.className = 'flex flex-wrap gap-1.5 mt-3';
          tagRow.innerHTML = tags; // tags built from textContent — safe
          article.appendChild(tagRow);
        }
        return article;
      }

      // API returns newest-first; reverse so prepending preserves order
      events.slice().reverse().forEach(function (ev) {
        list.prepend(card(ev));
      });
    } catch (e) {
      console.error('archive: failed to load dynamic events', e);
    }
  }

  document.addEventListener('DOMContentLoaded', loadDynamicEvents);
</script>
