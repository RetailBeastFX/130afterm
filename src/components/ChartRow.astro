---
// One parallax chart row: the Kurumi-construction archive row from the
// Blue sampler — 24 candles + 1 tall teal finale, literal top/height
// percentages, flex-shrink: 0, 68% anchor, even gaps. The row lives
// inside its section's .rb-chartLayer; the bubble rides the same
// parallax transform (see HomeScripts). Data: src/data/chartRows.ts.
import { chartRows } from '../data/chartRows';

interface Props {
  row: string;
}

const { row } = Astro.props;
const data = chartRows[row];
if (!data) throw new Error(`Unknown chart row: ${row}`);
---

<div class="rb-chartLayer" aria-hidden="true">
  <div
    class="b-bgrow candleStick__archiveWrap rb-chartRow"
    data-section-row={row}
    data-sc_start=""
    data-sc_end=""
    data-sc_hight=""
    data-sc_low=""
  >
    {
      data.candles.map((c) => (
        <div
          class:list={['candleStick__archive', 'bg-candle', { 'bg-candle--tall': c.tall }]}
          data-result={c.r}
          style={`flex-shrink: 0; --co:${c.co};${c.tall ? ' --cc:#2dd4bf; margin-left:34px;' : ''}`}
        >
          <div class="candleStick__archiveCont">
            <div
              class="candleStick__archive--shadow"
              style={`top: ${c.sh[0]}%; height: ${c.sh[1]}%;`}
            />
            <div
              class="candleStick__archive--body"
              style={`top: ${c.bd[0]}%; height: ${c.bd[1]}%;`}
            />
          </div>
        </div>
      ))
    }
  </div>
  <div class="b-bg-bubble" aria-hidden="true">{data.bubble}</div>
</div>
