---
// Terminal feed, contained in the left rail (fidelity pass).
// Schedule and status lines only — NEVER prices. Static now: the
// 27s print loop is frozen. JS clones the authored block down the
// rail until it fills the page height. Sampler lines, verbatim
// (left block only — the old right column was cut in the sampler).
---

<aside class="b-rail b-rail-left" id="bRailLeft" aria-hidden="true">
  <div class="b-term-col rail-term" id="bTermCol">
    <div class="b-term-block">
      <p class="bl" style="--i:0">&gt; BOOT: RETAILBO DESKTOP</p>
      <p style="--i:1">&gt; CHART CITY ......... <span class="g">LOADED</span></p>
      <p style="--i:2">&gt; RB MODULE .......... <span class="g">ONLINE</span></p>
      <p class="g" style="--i:3">RTH 09:30 NEW YORK</p>
      <p class="bl" style="--i:4">ASIA 09:00 TOKYO</p>
      <p class="bl" style="--i:5">LONDON 08:00 OPEN</p>
      <p style="--i:6">ORB WINDOW 09:30–09:45 ET</p>
      <p class="g" style="--i:7">ORB: LEVELS DRAWN</p>
      <p style="--i:8">ORB: MIDLINE BIAS SET</p>
      <p class="g" style="--i:9">REGIME GATE: ARMED</p>
      <p style="--i:10">CHOP WATCH: 11:30 RULE</p>
      <p class="g" style="--i:11">BULLS: BUY SIDE</p>
      <p class="r" style="--i:12">BEARS: SELL SIDE</p>
      <p style="--i:13">PAPER TRADE FIRST</p>
      <p class="cur" style="--i:14">&gt; <span>▮</span></p>
    </div>
  </div>
</aside>

<script>
  // Clone the authored terminal block down the rail until it fills
  // the whole page height (cap 160 blocks; only ever adds). The feed
  // lives inside the rail — contained, never a background layer over
  // content — and stands static (the print animation is frozen).
  (function () {
    function fillTermRail() {
      var col = document.getElementById('bTermCol');
      var rail = document.getElementById('bRailLeft');
      if (!col || !rail) return;
      var H = rail.offsetHeight;
      if (!H) return;
      var blocks = col.querySelectorAll('.b-term-block');
      if (!blocks.length) return;
      var step = blocks[0].offsetHeight + 64;
      if (step <= 0) return;
      var n = blocks.length;
      while (n * step < H && n < 160) {
        col.appendChild(blocks[0].cloneNode(true));
        n++;
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fillTermRail);
    } else {
      fillTermRail();
    }
    window.addEventListener('resize', fillTermRail);
  })();
</script>
