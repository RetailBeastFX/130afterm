---
// ChartBackground — the full-page printing candlestick chart.
// The whole page background IS a candlestick chart: green + red candles
// on a deep navy graph-paper grid, spanning the full page height.
// Candles print/draw in as the user scrolls (scroll-linked reveal,
// never autoplay). A feathered center scrim keeps the chart muted behind
// the text column; it runs stronger in the gutters. Fixed layer, z-index
// -1: above the body background and the glow, below all content.
// Candle geometry is generated at build time from a fixed seed, so the
// server render and the client agree exactly. No 1:30 AM, no heartbeat.
function mulberry32(a: number) {
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const W = 1440;
const ROWS = 5;
const ROW_H = 180;
const COLS = 34;
const STEP = 42;
const X0 = 30;
const GREEN = '#2ee06f';
const RED = '#ff4040';

interface Candle {
  x: number;
  wickTop: number;
  wickBot: number;
  bodyY: number;
  bodyH: number;
  color: string;
  cmax: string;
}

const candles: Candle[] = [];
for (let r = 0; r < ROWS; r++) {
  const rand = mulberry32(1337 + r * 97);
  const bandTop = r * ROW_H + 24;
  const bandBottom = (r + 1) * ROW_H - 24;
  let mid = bandTop + (bandBottom - bandTop) * (0.35 + rand() * 0.3);
  for (let c = 0; c < COLS; c++) {
    const x = X0 + c * STEP;
    const bodyH = Math.round(16 + rand() * 30);
    const bodyY = Math.round(mid - bodyH / 2);
    const wickTop = Math.max(bandTop, Math.round(bodyY - 6 - rand() * 12));
    const wickBot = Math.min(bandBottom, Math.round(bodyY + bodyH + 6 + rand() * 12));
    const up = rand() > 0.5;
    // Stronger near the gutters, muted behind the text column.
    const edge = Math.min(1, Math.abs(x + 8 - W / 2) / 560);
    const cmax = (0.55 + 0.45 * edge).toFixed(2);
    candles.push({ x, wickTop, wickBot, bodyY, bodyH, color: up ? GREEN : RED, cmax });
    mid = Math.min(
      bandBottom - 42,
      Math.max(bandTop + 42, mid + (rand() - 0.5) * 36)
    );
  }
}
---

<div class="chart-bg" aria-hidden="true">
  <div class="cb-scrim"></div>
  <svg viewBox={`0 0 ${W} 900`} preserveAspectRatio="xMidYMid slice" role="presentation">
    {candles.map((c) => (
      <g class="cb-candle" style={`--cmax:${c.cmax}`}>
        <line x1={c.x + 8} y1={c.wickTop} x2={c.x + 8} y2={c.wickBot} stroke={c.color} stroke-width="2" />
        <rect x={c.x} y={c.bodyY} width="16" height={c.bodyH} fill={c.color} />
      </g>
    ))}
  </svg>
</div>

<script>
  (function () {
    var candles = Array.prototype.slice.call(document.querySelectorAll('.cb-candle'));
    if (!candles.length) return;

    // Reduced motion: the whole chart is printed already, static.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      candles.forEach(function (c) { c.classList.add('lit'); });
      return;
    }

    var ticking = false;
    function update() {
      ticking = false;
      var max = document.documentElement.scrollHeight - window.innerHeight;
      var p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 1;
      // Eased mapping: the chart fills in early and completes at the bottom.
      var lit = Math.round(Math.pow(p, 0.6) * candles.length);
      candles.forEach(function (c, i) {
        c.classList.toggle('lit', i < lit);
      });
    }
    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  })();
</script>

<style>
  .chart-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    /* Deep navy graph-paper grid, sampler rhythm (28px). */
    background-image:
      linear-gradient(rgba(110, 168, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(110, 168, 255, 0.07) 1px, transparent 1px);
    background-size: 28px 28px;
    transition: opacity 0.6s ease, filter 0.6s ease;
  }
  .chart-bg svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Feathered center scrim: the chart stays muted behind the text
     column and runs stronger in the open bands and gutters. */
  .chart-bg .cb-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0,
      transparent calc(50% - 640px),
      rgba(5, 11, 26, 0.5) calc(50% - 560px),
      rgba(5, 11, 26, 0.58) 50%,
      rgba(5, 11, 26, 0.5) calc(50% + 560px),
      transparent calc(50% + 640px),
      transparent 100%
    );
  }
  .chart-bg .cb-candle {
    opacity: 0;
    transform: scaleY(0);
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .chart-bg .cb-candle.lit {
    opacity: var(--cmax, 0.7);
    transform: scaleY(1);
  }
  @media (max-width: 820px) {
    .chart-bg .cb-scrim {
      background: linear-gradient(
        90deg,
        transparent 0,
        rgba(5, 11, 26, 0.42) 18%,
        rgba(5, 11, 26, 0.42) 82%,
        transparent 100%
      );
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .chart-bg .cb-candle { transition: none; }
  }
</style>
