---
// Marquee band — diagonal-striped RETAILBO ★ ticker between sections.
// Sampler content: twelve "RETAILBO ★" spans, doubled in markup so the
// 26s translateX(-50%) loop is seamless. Decorative; aria-hidden.
const items = Array.from({ length: 12 }, () => 'RETAILBO');
const track = [...items, ...items];
---

<div class="b-marquee" aria-hidden="true">
  <div class="b-marquee-track">
    {
      track.map(() => (
        <span>
          RETAILBO <i>★</i>
        </span>
      ))
    }
  </div>
</div>
