---
// Media — episode library, not a standard embed page.
// Featured video in a retro computer window, episode-cover thumbnail
// slots, split RetailBeastFX tutorials / RetailBo personal.
// No videos exist yet: every slot is an honest "Coming soon" —
// no invented titles, no fake embeds, no fake view counts.
// Sampler frame: outer dark OS window ("MEDIA — EPISODE LIBRARY"),
// white player window, sampler group headings + covers, verbatim.
interface Props {
  /** 'home' = featured + 2 per side + link to /media. 'full' = everything. */
  variant?: 'home' | 'full';
}

const { variant = 'home' } = Astro.props;

// Three slots per side in the full library; the first RBFX slot pairs
// with the written breakdown of the 11:30 chop rule.
const rbfx = [
  { pair: { href: '/lab/1130-chop-rule/' } },
  { pair: null },
  { pair: null },
];

const retailbo = [{}, {}, {}];

const rbfxShown = variant === 'home' ? rbfx.slice(0, 2) : rbfx;
const rbShown = variant === 'home' ? retailbo.slice(0, 2) : retailbo;
---

<div class="b-oswin dark">
  <div class="b-win-bar">
    <span class="wdot a"></span><span class="wdot b"></span><span class="wdot c"></span>
    <span class="b-win-title">MEDIA — EPISODE LIBRARY</span>
    <span class="b-win-ctl" aria-hidden="true"><i>–</i><i>□</i><i>×</i></span>
  </div>
  <div class="b-oswin-body">
    <div class="stack">
      <!-- Featured video — retro computer window -->
      <p class="b-sub-label">★ Featured video</p>
      <div class="b-win">
        <div class="b-win-bar">
          <span class="wdot a"></span><span class="wdot b"></span><span class="wdot c"></span>
          <span class="b-win-title">RETAILBO.EXE — MEDIA PLAYER</span>
          <span class="b-win-x" aria-hidden="true">×</span>
        </div>
        <div class="b-featured-slot">
          <span class="b-play-ring" aria-hidden="true">▶</span>
          <span class="b-soon">Coming soon</span>
          <p>No videos yet — the first one premieres here.</p>
        </div>
      </div>

      <!-- RetailBeastFX — trading tutorials -->
      <div class="b-media-group">
        <h3><span>Trading tutorials</span>RetailBeastFX — trading tutorials</h3>
        <div class="b-ep-grid">
          {rbfxShown.map((ep) => (
            <div class="b-ep">
              <div class="b-ep-cover">
                <span class="b-ep-candles" aria-hidden="true">▮ ▮ ▮</span>
                <span class="b-soon">Coming soon</span>
                <p>Episode cover</p>
              </div>
              {ep.pair && (
                <p class="b-pair-line">
                  Pairs with the written breakdown:{' '}
                  <a href={ep.pair.href}><strong>The 11:30 chop rule</strong></a>
                </p>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- RetailBo — personal videos & commentary -->
      <div class="b-media-group">
        <h3><span>Personal</span>RetailBo — personal videos &amp; commentary</h3>
        <div class="b-ep-grid">
          {rbShown.map(() => (
            <div class="b-ep">
              <div class="b-ep-cover">
                <span class="b-ep-candles" aria-hidden="true">☾ ★ ☾</span>
                <span class="b-soon">Coming soon</span>
                <p>Episode cover</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      {variant === 'home' && (
        <p>
          <a href="/media" class="btn btn-ghost">open the full episode library →</a>
        </p>
      )}
    </div>
  </div>
</div>
