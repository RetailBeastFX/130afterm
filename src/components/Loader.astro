---
// Loader — layered intro from the loading-screen blueprint.
// Sequence: dark blue fade → city lights glow → candles rise → RB's eyes
// illuminate → candlesticks draw in → logo → loading bar fills → hero.
// Brief (~2.4s), skippable, once per session, reduced-motion fallback.
// No heartbeat motif anywhere — cut Nov 27.
---
<div class="loader" id="rb-loader" role="status" aria-label="Loading RetailBo">
  <div class="loader-city" id="loader-city" aria-hidden="true">
    <img src="/assets/chart-city-skyline.webp" alt="" width="1170" height="658" />
  </div>

  <div class="loader-terminal" id="loader-terminal" aria-hidden="true">
    <p><span class="lt-dot"></span>MARKET STATUS: ONLINE</p>
    <p>FOREX ▲ · CRYPTO ▲ · STOCKS ▲ · OPTIONS ▲</p>
    <p>FUTURES ▲ · INDICES ▲ · COMMODITIES ▲</p>
  </div>

  <!-- Candle-loading GIF: the loading screen's centerpiece (sampler).
       Under reduced motion the GIF hides and the SVG candle row below
       stands in as the static chart. -->
  <img
    class="loader-gif"
    src="/assets/candle-loading.gif"
    alt=""
    aria-hidden="true"
    width="640"
    height="360"
  />

  <div class="loader-candles" aria-hidden="true">
    <svg viewBox="0 0 420 120" role="presentation">
      <!-- green + red candles, rising in sequence -->
      <g class="lc-candle" style="transition-delay: 0.15s">
        <line x1="30" y1="30" x2="30" y2="95" stroke="#2ee06f" stroke-width="2" />
        <rect x="22" y="48" width="16" height="34" fill="#2ee06f" />
      </g>
      <g class="lc-candle" style="transition-delay: 0.3s">
        <line x1="80" y1="22" x2="80" y2="88" stroke="#ff4040" stroke-width="2" />
        <rect x="72" y="38" width="16" height="32" fill="#ff4040" />
      </g>
      <g class="lc-candle" style="transition-delay: 0.45s">
        <line x1="130" y1="38" x2="130" y2="100" stroke="#2ee06f" stroke-width="2" />
        <rect x="122" y="52" width="16" height="36" fill="#2ee06f" />
      </g>
      <g class="lc-candle" style="transition-delay: 0.6s">
        <line x1="180" y1="18" x2="180" y2="82" stroke="#2ee06f" stroke-width="2" />
        <rect x="172" y="34" width="16" height="30" fill="#2ee06f" />
      </g>
      <g class="lc-candle" style="transition-delay: 0.75s">
        <line x1="230" y1="28" x2="230" y2="92" stroke="#ff4040" stroke-width="2" />
        <rect x="222" y="44" width="16" height="34" fill="#ff4040" />
      </g>
      <g class="lc-candle" style="transition-delay: 0.9s">
        <line x1="280" y1="14" x2="280" y2="78" stroke="#2ee06f" stroke-width="2" />
        <rect x="272" y="30" width="16" height="32" fill="#2ee06f" />
      </g>
      <g class="lc-candle" style="transition-delay: 1.05s">
        <line x1="330" y1="24" x2="330" y2="90" stroke="#2ee06f" stroke-width="2" />
        <rect x="322" y="40" width="16" height="34" fill="#2ee06f" />
      </g>
      <g class="lc-candle" style="transition-delay: 1.2s">
        <line x1="380" y1="34" x2="380" y2="98" stroke="#ff4040" stroke-width="2" />
        <rect x="372" y="50" width="16" height="32" fill="#ff4040" />
      </g>
      <!-- RB's eyes illuminate: two glowing green eyes over the candles -->
      <g class="lc-eyes" id="loader-rb-eyes">
        <circle cx="196" cy="112" r="5" fill="#2ee06f" />
        <circle cx="224" cy="112" r="5" fill="#2ee06f" />
      </g>
    </svg>
  </div>

  <div class="loader-logo" id="loader-logo">
    <p class="logo-text">Retail<span class="accent">Bo</span></p>
    <p class="loader-sub">Trade · Learn · Grow · Be Free</p>
  </div>

  <div class="loader-markets" id="loader-markets" aria-hidden="true">
    <span class="lm-bulls">BULLS ▲ <i style="--w: 62%"></i></span>
    <span class="lm-bears">BEARS ▼ <i style="--w: 38%"></i></span>
  </div>

  <div class="loader-bar-wrap">
    <div class="loader-bar" aria-hidden="true"><i id="loader-fill"></i></div>
    <p class="loader-pct"><span id="loader-pct">0</span>%</p>
    <p class="loader-welcome" id="loader-welcome">Welcome to RetailBo</p>
  </div>

  <button class="loader-skip" id="loader-skip" type="button">Skip intro →</button>
</div>

<script is:inline>
  (function () {
    var loader = document.getElementById('rb-loader');
    if (!loader) return;

    // Never trap the page: CSS failsafe fades the loader out regardless.
    function dismiss() {
      if (loader.classList.contains('done')) return;
      loader.classList.add('done');
      try { sessionStorage.setItem('rb-loader-shown', '1'); } catch (e) {}
      setTimeout(function () { if (loader.parentNode) loader.parentNode.removeChild(loader); }, 600);
    }

    // Once per session — returning visitors go straight to the hero.
    try {
      if (sessionStorage.getItem('rb-loader-shown')) { loader.remove(); return; }
    } catch (e) {}

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var fill = document.getElementById('loader-fill');
    var pct = document.getElementById('loader-pct');
    var city = document.getElementById('loader-city');
    var logo = document.getElementById('loader-logo');
    var terminal = document.getElementById('loader-terminal');
    var eyes = document.getElementById('loader-rb-eyes');
    var markets = document.getElementById('loader-markets');
    var welcome = document.getElementById('loader-welcome');

    if (reduced) {
      if (fill) fill.style.width = '100%';
      if (pct) pct.textContent = '100';
      setTimeout(dismiss, 250);
      return;
    }

    var skip = document.getElementById('loader-skip');
    if (skip) skip.addEventListener('click', dismiss);
    loader.addEventListener('click', function (e) {
      if (e.target === loader) dismiss();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') dismiss();
    });

    // Layered sequence: bar fills over 2050ms, loader dismisses at 2400ms.
    var start = Date.now();
    var BAR_DURATION = 2050;
    var DISMISS_AT = 2400;
    setTimeout(function () { if (city) city.classList.add('on'); }, 150);
    setTimeout(function () { if (terminal) terminal.classList.add('on'); }, 350);
    document.querySelectorAll('#rb-loader .lc-candle').forEach(function (c) {
      c.classList.add('on');
    });
    setTimeout(function () { if (eyes) eyes.classList.add('on'); }, 950);
    setTimeout(function () { if (logo) logo.classList.add('on'); }, 1400);
    setTimeout(function () { if (markets) markets.classList.add('on'); }, 1650);
    setTimeout(function () { if (welcome) welcome.classList.add('on'); }, 1800);

    var timer = setInterval(function () {
      var p = Math.min(100, Math.round(((Date.now() - start) / BAR_DURATION) * 100));
      if (fill) fill.style.width = p + '%';
      if (pct) pct.textContent = String(p);
      if (p >= 100) {
        clearInterval(timer);
        var remaining = DISMISS_AT - (Date.now() - start);
        setTimeout(dismiss, Math.max(0, remaining));
      }
    }, 60);
  })();
</script>

<style>
  /* Failsafe: if JS never runs, the loader still fades away. */
  .loader {
    animation: loader-failsafe 0.6s ease 5s forwards;
  }
  @keyframes loader-failsafe {
    to { opacity: 0; visibility: hidden; }
  }
  /* Terminal status box — second layer of the intro. */
  .loader-terminal {
    position: relative;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    line-height: 1.9;
    color: var(--pale);
    text-align: center;
    background: rgba(2, 6, 15, 0.72);
    border: 1px solid rgba(46, 224, 111, 0.5);
    border-radius: 8px;
    padding: 10px 18px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .loader-terminal.on { opacity: 1; transform: translateY(0); }
  .loader-terminal .lt-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 10px 2px rgba(46, 224, 111, 0.75);
    margin-right: 8px;
    animation: lt-pulse 1.6s ease-in-out infinite;
  }
  @keyframes lt-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }
  /* RB's glowing green eyes over the candles. */
  .loader-candles .lc-eyes {
    opacity: 0;
    transition: opacity 0.5s ease;
    filter: drop-shadow(0 0 8px rgba(46, 224, 111, 0.9));
  }
  .loader-candles .lc-eyes.on { opacity: 1; }
  /* Bull/bear monitors — late layer, just before the bar finishes. */
  .loader-markets {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .loader-markets.on { opacity: 1; transform: translateY(0); }
  .loader-markets .lm-bulls { color: var(--green); }
  .loader-markets .lm-bears { color: var(--red); }
  .loader-markets i {
    display: inline-block;
    vertical-align: middle;
    width: 44px;
    height: 8px;
    margin-left: 6px;
    border-radius: 2px;
    background: currentColor;
    opacity: 0.75;
  }
  .loader-welcome {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--pale);
    text-align: center;
    margin-top: 10px;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .loader-welcome.on { opacity: 1; }
  @media (max-width: 560px) {
    .loader-terminal { display: none; }
  }
</style>
