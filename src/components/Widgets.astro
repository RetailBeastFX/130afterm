---
// Live widgets band — five retro windows, all live elements.
// Sampler copy + titlebars, verbatim. Widget 1 keeps the branch's LIVE
// session-opens body (a deliberate deviation from the sampler's static
// 7-market list — a live element beats a static one); the other four
// match the sampler. No heartbeat monitor — cut Nov 27.
---
<div class="b-widgets-band b-reveal" id="b-now" aria-label="Live widgets">
  <div class="b-widgets">
    <!-- 1 — Market status terminal: session opens, live -->
    <div class="b-win b-widget">
      <div class="b-win-bar">
        <span class="wdot a"></span><span class="wdot b"></span><span class="wdot c"></span>
        <span class="b-win-title">MARKET_STATUS — TERMINAL</span>
        <span class="b-win-x" aria-hidden="true">×</span>
      </div>
      <div class="b-widget-body">
        <p class="b-term-status" id="widget-live-now">LIVE NOW: <b>—</b></p>
        <div class="b-term-list">
          <span>RTH 09:30 ET <i>▲</i></span>
          <span>ASIA 09:00 JST <i>▲</i></span>
          <span>LONDON 08:00 GMT <i>▲</i></span>
        </div>
        <p class="b-widget-note" id="widget-next-open">next open: 9:30 RTH</p>
      </div>
    </div>

    <!-- 2 — Bull vs Bear indicator -->
    <div class="b-win b-widget">
      <div class="b-win-bar">
        <span class="wdot a"></span><span class="wdot b"></span><span class="wdot c"></span>
        <span class="b-win-title">BULL_VS_BEAR — THE FIGHT</span>
        <span class="b-win-x" aria-hidden="true">×</span>
      </div>
      <div class="b-widget-body">
        <figure class="b-widget-art">
          <img
            src="/assets/bull-bear.gif"
            alt="Animated bull and bear: a neon-green bull and a crimson-red bear surging toward each other and clashing over the candlestick chart."
            width="440"
            height="248"
            loading="lazy"
          />
        </figure>
        <div class="b-bb">
          <span class="b-bb-bull">▲ BULLS BUY</span>
          <span class="b-bb-bear">BEARS SELL ▼</span>
        </div>
        <p class="b-widget-note">Green is the buy side. Red is the sell side. The city runs on the fight between them.</p>
      </div>
    </div>

    <!-- 3 — Animated chart window -->
    <div class="b-win b-widget">
      <div class="b-win-bar">
        <span class="wdot a"></span><span class="wdot b"></span><span class="wdot c"></span>
        <span class="b-win-title">CHART — LIVE RENDER</span>
        <span class="b-win-x" aria-hidden="true">×</span>
      </div>
      <div class="b-widget-body">
        <img
          class="b-chart-gif"
          src="/assets/chart-loop.gif"
          alt="Animated candlestick chart loop: green and red candles printing one by one, left to right, on a dark navy grid."
          width="640"
          height="360"
          loading="lazy"
        />
        <p class="b-widget-note">Candles printing left to right, on loop — the same market that tracks your scroll in the gutter.</p>
      </div>
    </div>

    <!-- 4 — RB mascot callout -->
    <div class="b-win b-widget">
      <div class="b-win-bar">
        <span class="wdot a"></span><span class="wdot b"></span><span class="wdot c"></span>
        <span class="b-win-title">RB — MASCOT CALLOUT</span>
        <span class="b-win-x" aria-hidden="true">×</span>
      </div>
      <div class="b-widget-body">
        <div class="b-callout-body">
          <img
            class="b-callout-img"
            src="/assets/rb-pointing.gif"
            alt="RB pointing straight at you — neon-green horns and glowing eyes, green wrench in his other hand, bobbing gently."
            width="88"
            height="132"
            loading="lazy"
          />
          <blockquote class="b-callout-bubble">The 15-minute ORB is the strategy. The 1-minute will lie to you.</blockquote>
        </div>
      </div>
    </div>

    <!-- 5 — Article progress display -->
    <div class="b-win b-widget">
      <div class="b-win-bar">
        <span class="wdot a"></span><span class="wdot b"></span><span class="wdot c"></span>
        <span class="b-win-title">ARTICLE_PROGRESS — READER</span>
        <span class="b-win-x" aria-hidden="true">×</span>
      </div>
      <div class="b-widget-body">
        <p class="b-prog-num"><span id="widget-pct">0</span>%</p>
        <div class="b-prog-track" aria-hidden="true"><div class="b-prog-fill" id="widget-fill"></div></div>
        <p class="b-widget-note">How far down this page you've read. The gutter candles fill in as you go — there's something at the bottom.</p>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    // ── Session opens: which session is live, what's next ──
    var liveEl = document.getElementById('widget-live-now');
    var nextEl = document.getElementById('widget-next-open');
    function etParts(d) {
      try {
        var fmt = new Intl.DateTimeFormat('en-US', {
          timeZone: 'America/New_York',
          hour: 'numeric', minute: 'numeric', hour12: false,
        });
        var parts = fmt.formatToParts(d);
        var h = 0, m = 0;
        parts.forEach(function (p) {
          if (p.type === 'hour') h = parseInt(p.value, 10) % 24;
          if (p.type === 'minute') m = parseInt(p.value, 10);
        });
        return { h: h, m: m };
      } catch (e) {
        return { h: d.getUTCHours(), m: d.getUTCMinutes() };
      }
    }
    function updateSessions() {
      var now = new Date();
      var et = etParts(now);
      var mins = et.h * 60 + et.m;
      var live = 'BETWEEN SESSIONS';
      if (mins >= 570 && mins < 960) live = 'NEW YORK — RTH';
      else if (mins >= 180 && mins < 570) live = 'LONDON';
      else if (mins >= 1140 || mins < 180) live = 'ASIA';
      if (liveEl) liveEl.innerHTML = 'LIVE NOW: <b>' + live + '</b>';
      // Next 9:30 ET open
      var target = new Date(now);
      target.setHours(9, 30, 0, 0);
      // Convert: this is local-time math; approximate by ET offset via Intl is
      // overkill for a preview widget — compute in ET by shifting with the
      // difference between local and ET hours.
      var etNow = new Date(now.getTime());
      var localH = now.getHours();
      var shift = et.h - localH;
      etNow.setHours(etNow.getHours() + shift, et.m, 0, 0);
      var next = new Date(etNow);
      next.setHours(9, 30, 0, 0);
      if (next <= etNow) next.setDate(next.getDate() + 1);
      var diffMin = Math.round((next - etNow) / 60000);
      var hh = Math.floor(diffMin / 60);
      var mm = diffMin % 60;
      if (nextEl) nextEl.textContent = 'next open: 9:30 RTH in ' + hh + 'h ' + String(mm).padStart(2, '0') + 'm';
    }
    updateSessions();
    setInterval(updateSessions, 60000);

    // ── Article progress: wired to real scroll position ──
    var fill = document.getElementById('widget-fill');
    var pct = document.getElementById('widget-pct');
    if (!fill) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      fill.style.width = '100%';
      if (pct) pct.textContent = '100';
      return;
    }
    var ticking = false;
    function updateProgress() {
      ticking = false;
      var max = document.documentElement.scrollHeight - window.innerHeight;
      var p = max > 0 ? Math.round(Math.min(1, Math.max(0, window.scrollY / max)) * 100) : 100;
      fill.style.width = p + '%';
      if (pct) pct.textContent = String(p);
    }
    window.addEventListener('scroll', function () {
      if (!ticking) { ticking = true; requestAnimationFrame(updateProgress); }
    }, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();
  })();
</script>
