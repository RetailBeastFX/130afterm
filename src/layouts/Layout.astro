---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  active?: string;
}

const {
  title = '130 AM // after hours.',
  description = 'Bo\u2019s hangout spot on the internet. Father. Trader. Builder. Documenting the process, not the highlight reel.',
  active = 'home',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#17110a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;700&family=Caveat:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased">
    <slot />

    <script is:inline>
      // ── Scroll reveal ─────────────────────────────────────────────────
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('.reveal').forEach(function (el) {
            el.classList.add('visible');
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.06, rootMargin: '0px 0px -8px 0px' }
        );
        function observeAll() {
          document.querySelectorAll('.reveal').forEach(function (el) {
            io.observe(el);
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', observeAll);
        } else {
          observeAll();
        }
      })();

      // ── Marker draw-in ──────────────────────────────────────────────
      // Highlighted lines draw across when scrolled into view.
      (function () {
        var marks = document.querySelectorAll('mark.hl, .prose-room mark');
        if (!marks.length) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          marks.forEach(function (m) { m.classList.add('lit'); });
          return;
        }
        var mio = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('lit');
                mio.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.35 }
        );
        marks.forEach(function (m) { mio.observe(m); });
      })();

      // ── Terminal typing ─────────────────────────────────────────────
      // [data-type] labels type out on load; lab note section headers
      // type out when scrolled into view. No-JS keeps full text.
      (function () {
        function clean(el) {
          return el.textContent.replace(/\s+/g, ' ').trim();
        }
        function typeInto(el, text, speed) {
          var cursor = document.createElement('span');
          cursor.className = 'type-cursor';
          el.textContent = '';
          el.appendChild(cursor);
          var i = 0;
          var timer = setInterval(function () {
            i += 1;
            el.textContent = text.slice(0, i);
            el.appendChild(cursor);
            if (i >= text.length) {
              clearInterval(timer);
              setTimeout(function () {
                if (cursor.parentNode) cursor.parentNode.removeChild(cursor);
              }, 900);
            }
          }, speed);
        }

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        // Above-fold labels
        document.querySelectorAll('[data-type]').forEach(function (el) {
          var text = clean(el);
          function start() { typeInto(el, text, 55); }
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', start);
          } else {
            start();
          }
        });

        // Lab note section headers — clear early, type on scroll
        var heads = document.querySelectorAll('.lab-prose h2');
        if (!heads.length) return;
        var tio = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                var el = entry.target;
                tio.unobserve(el);
                typeInto(el, el.getAttribute('data-fulltext'), 34);
              }
            });
          },
          { threshold: 0.6 }
        );
        heads.forEach(function (h) {
          h.setAttribute('data-fulltext', clean(h));
          h.textContent = '';
          tio.observe(h);
        });
      })();

      // ── Seasonal mode ─────────────────────────────────────────────
      // Date-gated holiday touches. Add new seasons as date ranges here.
      (function () {
        var now = new Date();
        var m = now.getMonth(); // 0-indexed
        var d = now.getDate();
        var season = null;
        if ((m === 9 && d >= 1) || (m === 10 && d <= 2)) season = 'halloween';
        // future: else if (...) season = 'winter';
        if (!season) return;
        document.body.classList.add('season-' + season);
        if (season === 'halloween') {
          var tag = document.getElementById('hero-tagline');
          if (tag) tag.textContent = tag.textContent.replace('🌙', '🎃');
        }
      })();
    </script>
  </body>
</html>
